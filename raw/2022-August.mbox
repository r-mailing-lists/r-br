genes <- read.csv('~/Downloads/NePCa.csv')

genes[1:4,1:4]

g_max <- aggregate(. ~X, data = genes, max)
g_max[1:4,1:4]

rownames(g_max) <- g_max$X

gene_matrix <- as.matrix(g_max[,-1])
is.numeric(gene_matrix)
gene_matrix[1:4,1:4]

Daniel



