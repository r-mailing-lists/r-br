Caríssimos,

Uma dúvida e sugestões de leitura.

A dúvida é que tipo de implementação do modelo de Ising Mauro quer.
Você quer a simulação do modelo de Ising (ou, melhor, de Potts), ou o
seu uso como distribuição a priori em um esquema de classificação
bayesiano? Se for o primeiro, garanto que é um exercício relativamente
simples implementar o Gibbs sampler e os algoritmos de Swendsen-Wang e
de Wolff.

As sugestões são as seguintes:

A referência fundamental para classificação e restauração de imagens
usando prioris markovianas:
@ARTICLE{geman84,
  author = {D. Geman and S. Geman},
  title = {Stochastic relaxation, {G}ibbs distributions and the
{B}ayesian restoration
	of images},
  journal = {IEEE Transactions on Pattern Analysis and Machine Intelligence},
  year = {1984},
  volume = {6},
  pages = {721--741},
  number = {6}}

Dois algoritmos para gerar ocorrências do modelo de Potts:
@ARTICLE{SwendsenWang87,
  author = {R. Swendsen and J. Wang},
  title = {Nonuniversal Critical Dynamics in {M}onte {C}arlo Simulations},
  journal = {Physical Review Letters},
  year = {1987},
  volume = {58},
  pages = {86--88},
  number = {2}}
@ARTICLE{Wolff89a,
  author = {U. Wolff},
  title = {Collective {M}onte {C}arlo Updating for Spin Systems},
  journal = {Physical Review Letters},
  year = {1989},
  volume = {62},
  pages = {361--364},
  number = {4}}

Alguns trabalhos meus que podem ser de interesse:
@INBOOK{LivroWVC2010,
  chapter = {Elementos de Processamento e Análise Estatístico de Imagens usando
	{R}},
  pages = {1--63},
  title = {Fundamentos de Visão Computacional},
  publisher = {Unesp},
  year = {2011},
  editor = {M. A. Piteri and J. C. Rodrigues},
  author = {A. C. Frery and Perciano, T.}}
@BOOK{IPVG:2008,
  title = {Image Processing for Computer Graphics and Vision},
  publisher = {Springer},
  year = {2008},
  author = {L. Velho and A. C. Frery and J. Miranda},
  pages = {403},
  address = {London},
  edition = {2},
  doi = {10.1007/978-1-84800-193-0},
  isbn = {978-1-84800-192-3}}
@ARTICLE{FreryCorreiaFreitas:ClassifMultifrequency:IEEE:2007,
  author = {A. C. Frery and A. H. Correia and C. C. Freitas},
  title = {Classifying Multifrequency Fully Polarimetric Imagery with Multiple
	Sources of Statistical Evidence and Contextual Information},
  journal = {IEEE Transactions on Geoscience and Remote Sensing},
  year = {2007},
  volume = {45},
  pages = {3098--3109},
  number = {10},
  abstract = {This paper presents the use of a new distribution for
fully polarimetric
	image classification. Several classification strategies are compared
	in order to assess the importance of a careful statistical modeling
	of the data and the complementary nature of the information provided
	by different frequencies. Spatial context, which is relevant in order
	to obtain good results with noisy data, is described by means of
	the multiclass Potts model, and an iterated conditional modes classification
	algorithm that employs pseudolikelihood is proposed. The data are
	described using multivariate Gaussian laws and fully multilook polarimetric
	distributions arising from the multiplicative model. L-band, C-band,
	and both bands are used to assess the influence of dimensionality
	on the classification. Contextual and pointwise maximum-likelihood
	classifications are compared using real data. Results show that both
	context and number of frequencies contribute for better classification
	products, and that, a careful statistical description of the data
	leads to improved results.},
  doi = {10.1109/TGRS.2007.903828}}

Alejandro



