func41 <- function(y, a, sad, rate) {
	Compound <- function(n, y, a, sad, samp, rate) {
		RegDist <- function(n, sad, rate) {
			dcom <- paste("d", sad, sep="")
      		        dots <- list(n, rate)
			do.call(dcom, dots)
		}
		RegDist(n, sad, rate) * dpois(y, a * n)
	}
	integrate(Compound, 0, Inf, y, a, sad, samp, rate)$value
}

