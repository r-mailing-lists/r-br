correto - na verdade, eu prevejo que os resultados estarao incorretos,
pois vc precisa ver como os dados de anos/meses diferentes devem ser
combinados):

entra = read.csv2("~/Downloads/Arquivo 1.csv", dec = ",",
stringsAsFactors=FALSE)
entra$peso = as.numeric(gsub("\\,", "\\.", entra$peso))

combinado = with(entra, aggregate(list(peso=peso, val=val),
by=list(codigo=codigo), sum))
combinado$pond = combinado$val/combinado$peso
tmp = combinado[, c('codigo', 'pond', 'val')]
