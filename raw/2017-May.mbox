adicLinha <- function(x) {
    soma<-numeric()
    for(i in 1:ncol(x){

        if(is.numeric(x[,i])){

            soma[i] <-sum(x[,i],na.rm=TRUE)


        }


    }
     return(rbind(x,soma))
    }

ddply(dados,.(id,evento1,nomes),adicLinha)



