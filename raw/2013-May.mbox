Ah, vc pode fazer o seguinte no R:

#escolher os limites da integral
limsteste <- c(0,1)



#escolher a “precisão” numérica
precteste <- 0.0001

#escolher a função, por exemplo, x^2.
area <-function(lims,prec){
x<-seq(lims[1],lims[2],prec)

resp <- sum(x^2) / length(x)

return(resp)

}



area(limsteste,precteste)

 

