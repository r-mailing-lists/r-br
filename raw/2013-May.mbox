o scan() vai aceitar que tu entre dados até o 1o dado vazio (ou seja, até
dois 'enter' seguidos). Sugiro o readline() para isso.

media <- function() {
  soma = 0
  n=0
  cat('Digite uma nota: ')
  nota=as.double(readline())
  while (nota >= 0) {
    soma=soma+nota
    n = n + 1
    cat('Digite uma nota: ')
    nota= as.double(readline(""))
  }
  return (sprintf("%.1f",soma/2))
}
media()



