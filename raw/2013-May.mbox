 $ V4300: int  0 4 11 4 5 5 11 15 0 13 ...
 $ V4513: int  182 182 136 182 182 36 733 865 316 380 ...
 $ V0453: int  20 48 48 45 49 24 40 25 44 25 ...

> system.time( r <- rq(V4513 ~ V0453 + V4752 + V0401, tau=c(0.1,0.5,0.9), data=c2000) )
