Felipe, veja se é isto o que tu deseja. Talvez não seja a solução mais
elegante, mas aparentemente funciona:

# gera dados aleatorios

set.seed(123)

n <- 100

x <- paste(rpois(n, 5), rbinom(n, 1, .4)+1, rpois(n, 5), sep=".")

# separa os elementos das strings de acordo com os pontos

x.split <- unlist(strsplit(x, "[.]"))

# seleciona apenas os elementos do meio dos dados originais, que são os
elementos 2, 5, 8, etc. do vetor x.split

unlist(strsplit(x, "[.]"))[seq(from=2, to=length(x.split), by=3)]

# para transformar o resultado acima em numeros

as.numeric(unlist(strsplit(x, "[.]"))[seq(from=2, to=length(x.split),
by=3)])








