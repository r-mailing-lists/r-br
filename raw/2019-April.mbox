Subject: [R-br] Utilizar virgula como separador decimal no ggpmisc
Message-ID:
        <CACh34YJ4WzWnHtoGKVpxiaPdwh+uq+nkFE97rkApAwLtxhDugw em mail.gmail.com>
Content-Type: text/plain; charset="utf-8"

Prezados,

Estou com problemas em utilizar a "virgula" como separador decimal em
conjunto com o pacote ggpmisc. Utilizo este pacote para colocar a notação
da equação e coeficiente de determinação no gráfico. Segue CRM

#Carregar pacotes
library(ggplot2)
library(ggpmisc)
library(scales)

ggplot(iris, aes(x = Sepal.Length, y = Petal.Width)) +
  geom_point() +
  geom_smooth(method = "lm", color = "black", se = T,
              formula = y ~ x) +
  theme_classic() +
#Adiciona as notações com virgula no eixo X
  scale_x_continuous(breaks = seq(4, 8, .5), limits = c(4, 8),
                     labels = function(x) format(x,
                                                 decimal.mark = ",")) +
#Adiciona as notações com virgula no eixo Y
  scale_y_continuous(breaks = seq(0, 3, .5), limits = c(-.2, 3),
                     labels = function(x) format(x,
                                                 decimal.mark = ",")) +
#Adiciona a equação e o coeficiente de determinação, porem com "." como
separador
  stat_poly_eq(aes(label = paste(..eq.label.., ..rr.label.., sep = "~~~~")),
               formula =  y ~ x, parse = T)

