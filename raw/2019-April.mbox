Ainda continuando o exemplo, veja se ajuda

nomes<-paste("[",LETTERS,"]",sep="")
df4<-data.frame(cidades=rownames(df3))
for(i in 1:length(nomes)){
  df4<-cbind(df4,apply(df[grep(nomes[i],names(df))],1,sum))
}
df4<-df4[-1]
names(df4)<-LETTERS
df4
df4[1:3]==df2

Att.
Alan

