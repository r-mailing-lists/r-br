    points(c(x,x),c(y1,y2),col=cores[sample(1:8,1)],lwd=sample(1:4,1),pch=20,cex=round(runif(1,1,4)))
    if (i%%5 == 0 & i <=25)
    {
      cont=cont+1
      text(0,pos[cont],eq[cont])
    }
  }
  text(1.2,-2.5,"AMO-TE",col="red",cex=3)
}
core()



