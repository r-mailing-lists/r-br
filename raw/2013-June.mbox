O comando ficou assim e funcionou bem.
comparison<- with(dados, HSD.test(y, trat,df,MSerror,alpha=0.05,group=TRUE))
par(cex=0.9,mar=c(5.1, 5.1, 4.1, 2.1))
bar.group(comparison$groups,horiz=FALSE,col=rainbow(5),border="blue",
          xlim=c(0,6), ylim=c(0,3.5),las=1)
title(cex.lab=1.2, main="Raiz", xlab="Porcentagem de N", 
      ylab=expression('Micromol '~'NO'[3]~'g'^-1~'h'^-1))


 
