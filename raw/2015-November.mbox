>> z<-qnorm(0.975) #percentil da Normal padrão
>> li<- d - (z*dvd) # Limite inferior
>> ls<- d + (z*dvd) # Limite superior
>> cbind(d,li,ls) # Intervalo de Confiança de 95%. Como o valor zero não
