Enquanto o Walmes não posta algo, vai se contentando com isso. Dê uma olhada na ggplot2, pois é outra opção à graphics.

y <- rnorm(20)
x <- rep(c(0,10,20,30),rep(5,4))
medias <- tapply(y,x,mean)
desv <- tapply(y,x,sd)
plot(tapply(y,x,mean) ~
 seq(0,30,10),ylim=c(-2,2))
segments(0,medias[1],0,medias[1]-desv[1])
segments(0,medias[1],0,medias[1]+desv[1])
segments(10,medias[2],10,medias[2]-desv[2])
segments(10,medias[2],10,medias[2]+desv[2])
segments(20,medias[3],20,medias[3]-desv[3])
segments(20,medias[3],20,medias[3]+desv[3])
segments(30,medias[4],30,medias[4]-desv[4])
segments(30,medias[4],30,medias[4]+desv[4])
 

