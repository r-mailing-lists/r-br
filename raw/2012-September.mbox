Estou tentando plotar alguns pontos no mapa de Monte Santo, Bahia através
do Rgoogle e rgdal, mas o mapa que aparece ao final não é o de Monte Santo.
Por favor, o que estou fazendo errrado. Segue o CMR:

#dados de latitude
bdlt <- c(-43.565,-43.564,-43.563,-43.565,-43.564)
#dados de longitude
bdlg <- c(-10.518,-10.466,-10.412,-10.516,-10.474)
dados <- as.data.frame(cbind(bdlt,bdlg))
names(dados) <- c("lat","lon")
attach(dados,warn.conflicts=F)
dados

dados$size <- "tiny"
dados$col <- "red"
dados$char <- ""
#get the bounding box:
bb <- qbbox(lat = dados[,"lat"], lon = dados[,"lon"])

#download the map:
mapa <- GetMap.bbox(bb$lonR, bb$latR, destfile = "dados.png", GRAYSCALE =F,
markers = dados);

#determine the max zoom, so that all points fit on the plot
zoom <- min(MaxZoom(latrange=bb$latR,lonrange=bb$lonR));
plot.new()
PlotOnStaticMap(mapa,lat = dados[,"lat"], lon = dados[,"lon"],
                       cex=1.5,pch=20,col=c('blue', 'green', 'red'),
add=F);

