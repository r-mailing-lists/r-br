também tinha entendido errado teu problema, aqui vai um que faz o que tu
pediu, baseado na tua multivar

n <- ncol(multivar)
dv <- matrix(0,n,n)
for (i in 1:n) {
 for (j in i:n) {
   dv[i,j] <- dv[j,i] <- sum((multivar[,i]-multivar[,j])^2)^.5
 }
}

