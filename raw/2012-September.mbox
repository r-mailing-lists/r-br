*Tenho algo que fiz e está bem implementado*
*
*
*
PudT <- function(Theta,ai,bi,ci,D){
    PudT <- ci + (1-ci)/(1 + exp(-D*ai*(Theta-bi)))
    PudT
}

parit <- data.frame(id= ..., a = ..., b=..., c=....)
respo <- matrix(ncol=nitem,nrow=nalu)

    for(k in 1:nitem){
                respo[,k] <-
                as.integer(PudT(
                  Theta    = [,2],
                     ai    = parit[k,'a'],
                     bi    = parit[k,'b'],
                     ci    = parit[k,'c'],
                     D     = 1) >
               runif(nalu,0,1))
}




