consolida3 <- function(Candidato) {
   temporario <- merge(x = perc_validos,
                       y = votos_regiao[, .(Regiao,
                                            eval(Candidato))],
                       by = "Regiao",
                       all.x = TRUE,
                       sort = TRUE)
   return(temporario)
}
consolida3(Candidato = "Fernando Haddad")

