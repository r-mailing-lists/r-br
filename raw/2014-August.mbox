Segue abaixo uma possível solução:


f <- Vectorize(function(x, i) {
  x <- x + i
    p1 <- x %/% 10
    p2 <- x %% 10
    p1 + p2
}, 'i')

vi <- c(1,2,5,6) 
f(vi, 1:9)


Att,

Rubem

