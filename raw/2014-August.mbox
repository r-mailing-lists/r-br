ja' q e' mesmo para fins didaticos, considere a seguinte solucao:

myexp <- function(B,C){
  stopifnot(is.integer(C), C >= 0)
  if (C == 0)
    return(1)
  B*myexp(B, C-1L)
}
myexp(2, 5L)

b

