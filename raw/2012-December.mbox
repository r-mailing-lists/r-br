nrep = 50
matriz_result = matrix(,nrow=nrep,ncol=7)

for(i in 1:nrep){
  par = trunc(runif(5,0,4))
  resultado = arima(retirar(serie,3)$Serie,order=c(par[1],2,par[2]),
                    seasonal = list(order = c(par[3], par[4], par[5])))
  aic = resultado$aic
  matriz_result[i,] = c(par[1],1,par[2:5],aic)
}

