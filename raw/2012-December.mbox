sobrenome=c("Andrade","Silva","Soares","Pereira","Cunha","Lima")
idade=c(67,88,78,60,68,80)
ano=c(1945,1924,1934,1952,1944,1932)
dataint=c(20121208,20121103,20120302,20120105,20121004,20121209)
