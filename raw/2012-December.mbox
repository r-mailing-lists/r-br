Caros colegas ...
Quando vou rodar este script abaixo eu não consigo fazer com que as observações saiam em cada mês ... 
Esta saaindo apenas um pontinho preto.
Será que algum colega poderia me auxiliar neste script?
Os dados estão em anexo.

Grata

dados <- read.table("D:\\Dados.txt",h=F)

dadost <- as.matrix(dados[,3])

x <- c(710000,712000,712000,710000)
y <- c(7700000,7700000,7900000, 7900000)
poly <- cbind(x,y)
plot(poly)

n <- max(dadost)

############################## ############################## ############################
        GRAFICO DE TODOS OS TEMPOS
############################## ############################## ##############################

dts <- c("Nov2001","Dez2001"," Jan2002","Fev2002","Mar2002",
         "Abr2002","Maio2002","Jun2002" ,"Jul2002","Ago2002","Set2002" )

par(mfrow=c(7,3),mar=rep(2,4))
for(i in 1:n){
    plot(poly,type="n",xlab="x", ylab="y",main=dts[i])
    points(dados[,1][dadost==i], dados[,2][dadost==i],xlab="x", ylab="y",main="")}

