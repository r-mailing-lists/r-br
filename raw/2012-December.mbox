Usando merge() e expand.grid() da pra fazer, mas se o número de combinações
semana-locais for muito grande talvez haja uma solução mais viável

dados <- matrix(scan(),ncol=4,byrow=T)
1 1 0.10 15
2 1 0.15 16
4 1 0.20 20
1 2 0.27 23
4 2 0.15 25

dados <- data.frame(dados)
names(dados) <- c('dia','local','dado1','dado2')

# Supondo 4 dias e 2 locais:
tudo <- expand.grid(dia=1:4,local=1:2)

merge(dados,tudo,all.x=T,all.y=T)


[]'s



