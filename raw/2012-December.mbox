Acho que o único jeito de fazer isso é criando uma classe e definindo o
print dela. (o lm nada mais é do que uma lista)

a <- list()
a[[1]] <- rnorm(1:100)
a[[2]] <- rnorm(1:100)
a[[3]] <- lm(a[[1]] ~ a[[2]])
print.macaco <- function(x) {
 print(x[[3]])
}
a
class(a) <- 'macaco'
a



