 if (runif(1) < .5) {
#  m <- sample(c(1,3,7,9),1)
  m <- joga(jogo)
  jogo[m] <- 1 
  x <- as.integer((m-1)/3)+.5
  y <- 2.5 - ((m-1) %% 3)
  points(x,y,pch='O')
 }
 a <- getGraphicsEvent("Tic-Tac-Toe :)", onMouseUp = clica, onKeybd = tecla) 
 return(invisible())
}

