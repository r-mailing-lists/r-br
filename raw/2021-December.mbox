References: <CAFfGvyKV5XWc3K68U4gOq5NPb=Lzy43twmMitwiKaHHLz6wVPQ@mail.gmail.com>
 <CAKrF98m-L6OsY43rOgeC0=BXGr_O2cWWJac1Xk3cwwefaDh7hg@mail.gmail.com>
 <CAFfGvy+oBHvZG8wX_+_ncpZw99iO0JYTjb5-pUXb5_GgZdc47Q@mail.gmail.com>
Message-ID: <CAAmR27_oErE4y7Au3wxEpx9LQ4VjtLm=e7Z9ROLfp8eR9ZNW2Q@mail.gmail.com>

library(survival)
library(broom)
library(tidyverse)

fit <- survfit(Surv(time, status) ~ x, data = aml)
df<-tidy(fit)
df$cumhaz <- fit$cumhaz
df %>% filter(time%in%c(9,8,28,33,48))

fit1 <- summary(fit, times = c(14,28,35))
fit1

tab <- data.frame(time = fit1$time,
                  n.risk = fit1$n.risk,
                  n.event = fit1$n.event,
                  survival = fit1$surv,
                  std.err = fit1$std.err,
                  `lower 95% CI` = fit1$lower,
                  `upper 95% CI` = fit1$upper,
                  cumhaz = fit1$cumhaz,
                  strata = fit1$strata)

tab

