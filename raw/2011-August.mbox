>> head(dados)
>> dim(dados)
>> Transformação Box-Cox
>> require(MASS)
>> library(MASS)
>> motil
>> Trat
>> boxcox(motil+0.01~Trat, data=dados)
>> lambida=0.35
>> motili=(motil^(0.39) - 1)/0.39
>> motili
>> plot(motil~Trat)
>> plot(motili~Trat)
>> anava <- aov(motili ~ Trat, data = dados)
>> plot(anava)
>> shapiro.test(anava$res)
