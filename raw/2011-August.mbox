>>>>                        f <- function(n){
>>>>                                f1(y,frac,n)*f2(n)
>>>>                        }
>>>>                        myintegrate <- function() {
>>>>                                r <- 0
>>>>                                r1 <- 1
>>>>                                x1 <- 0
>>>>                                dx <- 20
>>>>                                while(r1 > 10e-500) {
>>>>                                        r1 <- integrate(f,x1,x1+dx)$value
>>>>                                        r <- r + r1
>>>>                                        x1 <- x1 + dx
>>>>                                }
>>>>                                integrate(f,x1,Inf)$valu
>>>>                        }
>>>>                        myintegrate()
>>>>                }
>>>>                f0(y,frac,n)/(1-f0(trunc,frac,n))
>>>>        },"y")
