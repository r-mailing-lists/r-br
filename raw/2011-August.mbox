equantileByCounts <- function(x, counts, qs){
    tot <- sum(counts)
    i <- order(x)
    x <- x[i]
    counts <- counts[i]
    partial <- cumsum(counts)
    qsObs <- qs*tot
    start <- floor(qsObs)
    end <- ceiling(qsObs)
    i <- length(qs)
    aux1 <- sapply(1:i,
                  function(.x, start, end, x){
                      coord <- c(start[.x], end[.x])
                      bins <- c(1, partial)
                      grps <- cut(coord, bins, labels=FALSE,
include.lowest=T)
                      mean(x[grps])
                  }, start=start, end=end, x=x)
    names(aux1) <- names(qs)
    return(aux1)
}
