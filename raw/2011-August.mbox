>>     json[i] <- getURL(url=request[i])
>>     temp <- fromJSON(json[i])
>>     latLng <- temp$results[[1]]$geometry$location
>>     store[i, ] <- latLng
>>   }
>>
>>   result <- cbind(address[, column], store)
>>   colnames(result) <- c("address", "lat", "lng")
>>   result
>> }
