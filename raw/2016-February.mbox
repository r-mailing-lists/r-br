Bom dia,

Elias, particularmente eu acredito que os colegas propuseram soluções
melhores, mas para seu código funcionar você deve definir o "ambiente" onde
a função será executada. Alterei seu código pra testar:

### <code r>
remove.variables <- function(dataset.name, vars.to.remove)
{
  # scan the variables to be removed
  for (x in 1 : length(vars.to.remove))
  {
    # transform command.Remove in "data$variable <- NULL"
    command.Remove <- paste(dataset.name,"$", vars.to.remove[x], " <-
NULL", sep="")

    # execute the command
    print(command.Remove)
    eval(parse(text=command.Remove), envir=.GlobalEnv)
  }
}

df <- get(data(mtcars))
names(df)
 # [1] "mpg"  "cyl"  "disp" "hp"   "drat" "wt"   "qsec" "vs"   "am"
"gear" "carb"

remove.variables("df", c("mpg", "hp"))
# [1] "df$mpg <- NULL"
# [1] "df$hp <- NULL"

names(df)
# [1] "cyl"  "disp" "drat" "wt"   "qsec" "vs"   "am"   "gear" "carb"
