segue sugestão:

## linux
"AB CD" > "ABCD"
sort(c("AB CD","ABCD"))
order(c("AB CD","ABCD"))

old = Sys.getlocale("LC_COLLATE")
Sys.setlocale("LC_COLLATE", "C")

"AB CD" > "ABCD"
sort(c("AB CD","ABCD"))
order(c("AB CD","ABCD"))

Sys.setlocale("LC_COLLATE", old)

