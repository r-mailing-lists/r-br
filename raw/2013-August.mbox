r=rnorm(8,15,8)

# não é o que vc quer
boxplot(r~f1*f2)

# vamos colocar os dados na ordem
i=interaction(f1,f2)
d=data.frame(f1,f2,i,r)

# coloque a ordem que você quiser
d=data.frame(d, ordem=c("2","1","2","1","3","4","3","4"))
d

# resolvido
boxplot(r~ordem, data=d, names=c("Fr.Adj","Fr.Dalb","Fu.Dalb","Fu.Adj"))


# compare os dois
X11()
boxplot(r~f1*f2)
X11()
boxplot(r~ordem, data=d, names=c("Fr.Adj","Fr.Dalb","Fu.Dalb","Fu.Adj"))



