i <- c("./maize-yield.csv", "./rice-yield.csv", "./soybean-yield.csv",
"./sugarcane-yield.csv", "./wheat-yield.csv")
gsub("^(./)(.*)(-.*)$","\\2", i, fixed=F)

[1] "maize"     "rice"      "soybean"   "sugarcane" "wheat"


