Ficou assim:

dados <- data.frame(x=1:10, v1=rnorm(10), v2=rnorm(10))

func <- function(data, funcao) {
 funcao <- parse(text=funcao)
 return(with(data, eval(funcao)))
}

func(dados, 'v1+v2')

