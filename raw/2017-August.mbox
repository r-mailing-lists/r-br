>>>>>> # insere o modelo e uma descricao
>>>>>>
>>>>>> > p <- paste("EXEC PersistModel @m='", teste_pequeno,"', @description
>>>>>> = 'Teste de serialização objeto pequeno'", sep = "")
>>>>>> > sqlQuery(conn, p)
>>>>>> character(0)
>>>>>> > rm(teste_pequeno)
