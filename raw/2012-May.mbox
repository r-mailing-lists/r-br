1L, 1L, 1L, 1L, 1L, 1L, 1L, 1L, 2L, 2L, 2L, 2L, 2L, 2L, 2L, 2L,
2L), .Label = c("SIM", "SINAN"), class = "factor")), .Names = c("ano",
"PE", "AL", "SP", "tipo"), class = "data.frame", row.names = c(NA,
-18L))

