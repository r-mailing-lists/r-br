agrupado por cyl

mtcars %>% group_by(cyl) %>%
  mutate(mpg.m = mean(mpg),
  wt.m = mean(wt)) %>%
  ggplot(aes(x=mpg, y=wt, color=as.factor( cyl ))) +
  geom_point(size=1) +
  geom_vline(aes(xintercept = mpg.m), col="black", linetype=2) +
  geom_hline(aes(yintercept = wt.m), col="red", linetype=2) +
  facet_grid( cyl ~ gear) +
  theme(legend.position="none")

ou geral

mtcars %>%
  mutate(mpg.m = mean(mpg),
  wt.m = mean(wt)) %>%
  ggplot(aes(x=mpg, y=wt, color=as.factor( cyl ))) +
  geom_point(size=1) +
  geom_vline(aes(xintercept = mpg.m), col="black", linetype=2) +
  geom_hline(aes(yintercept = wt.m), col="red", linetype=2) +
  facet_grid( cyl ~ gear) +
  theme(legend.position="none")





