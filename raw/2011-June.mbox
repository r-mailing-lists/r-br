No seu CMR faltou o pacote plotrix. Veja abaixo a solução pouco empenho da
lattice.

require(plotrix)
color.legend(1,1.5,9,8,col.labels,color,gradient="y",align="rb")

x <- seq(-1.95, 1.95, length=30)
y <- seq(-1.95, 1.95, length=35)
da <- expand.grid(x=x, y=y)
da$z <- with(da, x*y^2)

require(lattice)
wireframe(z~x+y, da, drape=TRUE, col.regions=jet.colors(100))

