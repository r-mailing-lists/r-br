Olá Tiago eu uso este programa para fazer o teste de médias.

# Teste Tukey
library(agricolae)
#   Tratameto
df<- df.residual(anava1)
MSerror<-(deviance(anava1))/df
comparison <- HSD.test(QEA,Tratamento,df,MSerror, group=TRUE)

#  Interação
df<- df.residual(mod)
MSerror<-(deviance(mod))/df
comparison <- HSD.test(QEA,Tratamento:Bloco,df,MSerror, group=TRUE

