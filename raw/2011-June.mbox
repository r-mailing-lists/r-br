x <- 1:10                 # vetor com as cartas do baralho
X <- sample(x)         # embaralhando as cartas

verificar <- function(X){
y <- 0
for(i in 1:length(X)){
if(X[i] == x[i]){
y[i] <- 1
}
else{
y[i] <- 0
}
}
return(sum(y))
}

