Oi,

Veja se isso funciona:

library(dplyr)
library(tidyr)

df2 <- df %>%
         mutate(id_curso = "id_curso") %>%
         pivot_wider(id_cols = nome,
                   names_from = id_curso,
                   values_from = curso) %>%
               unnest_wider(col = id_curso)



