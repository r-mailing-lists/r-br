library(tidyverse)

data <- ls_completed_timeseries_last_365$`12_T_DC_1`
names(data)[1] <- "time"

data %>%
        mutate(time2 = format(time, format="%H:%M:%S")) %>%
        filter(time2 >= "00:00:00" & time2 < "11:00:00") %>%
        select(-time2)


