> Olá Gilenio, seria algo assim:
>
> ### simula dados
>
> n <- 1000; beta <- c(-3,1)
> y <- integer(n)
> y[1] <- rbinom(1,1,.5)
> for (i in 2:n)
>   y[i] <- rbinom(1, 1, 1/(1+exp(-beta[1]-beta[2]*y[i-1])))
>
> ### estima modelo
>
> m <- glm(y ~ y2, family=binomial, data=data.frame(y=y[2:n], y2=y[2:n-1]))
> summary(m)
>
>
> Elias T. Krainski
