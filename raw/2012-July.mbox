Samuel, tente adaptar isso aqui

set.seed(123)
x <- rnorm(1000, 5, 2)
plot(density(x))
breaks <- sort(c(range(x), quantile(x, c(1,3)/4)))

dx <- density(x)
fx <- approxfun(dx$x, dx$y)
fx(0.5)

do.polygon <- function(x){
  y <- fx(x)
  return(list(x=c(min(x), x, max(x)), y=c(0, y, 0)))
}

seqs <- lapply(1:(length(breaks)-1),
               function(i){
                 x <- seq(breaks[i], breaks[i+1], l=30)
                 do.polygon(x)
               })
str(seqs)

plot(density(x))
polygon(seqs[[1]], density=2)

seqs[[1]]$density <- 3
seqs[[2]]$density <- 5
seqs[[3]]$density <- 9

plot(density(x))
lapply(seqs, function(i) do.call(polygon, i))

À disposição.
Walmes.

