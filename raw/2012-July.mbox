Também não sei se entendi a pergunta direito, mas se vc quer apenas um
"atalho" para chamar determinada linha usando apenas os valores de "a"
e "b", pode fazer algo como

f <- function(a, b){
  x <- paste("p", a, "n", b, sep = "")
  return(x)
}

> f(a = 1, b = 2)
[1] "p1n2"
> f(a = 1, b = 1)
[1] "p1n1"
> tab[f(1,1), ]
    k1     k2
1.8850 2.9375
> as.vector(tab[f(1,1),])
[1] 1.8850 2.9375


