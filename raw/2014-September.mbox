Basta você aproveitar o que tem em grid0, que tem as colunas e linhas de
blocos de árvores, combiná-los para fazer um fator. Confira no CMR.

str(grid0)
unique(grid0$L)
unique(grid0$C)

grid1$parc <- with(grid0, interaction(L, C))
nlevels(grid1$parc)
levels(grid1$parc)

grid1$parc <- with(grid0,
                   interaction(as.integer(as.factor(L)),
                               as.integer(as.factor(C)),
                               sep="-"))
nlevels(grid1$parc)
levels(grid1$parc)

grid2 <- aggregate(cbind(x, y)~parc, data=grid1, FUN=mean)
str(grid2)

plot(y~x, grid1, col=as.integer(grid1$parc))
with(grid2, text(x, y, labels=as.character(parc)))

subset(grid1, parc=="1-1")

