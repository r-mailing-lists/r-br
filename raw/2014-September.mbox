library(Rcpp)
cppFunction(
    'NumericVector fr0(NumericVector x){
        int n=x.size();
        NumericVector r(n);
        for (int i=0; i<n; i++){
           if (x[i] < -3){
              r[i]=0;
           }else if(x[i] >= -3 & x[i] <=2){
              r[i]=3*x[i];
           }else{
              r[i]=1;
           }
        }
        return r;
     }')
