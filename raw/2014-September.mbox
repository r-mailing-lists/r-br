Segue um CMR.

data(ex5, package="ExpDes")
str(ex5)

xtabs(~trat+genero, ex5)

m0 <- aov(sabor~bloco+trat/genero, data=ex5)

names(coef(m0))

m0$assign
gINt.effects <- names(coef(m0))[m0$assign==3]

generoINtrat <- lapply(paste0("trat", levels(ex5$trat)),
                       grep, gINt.effects)

summary(m0, split=list("trat:genero"=generoINtrat))

m1 <- aov(sabor~bloco+genero/trat, data=ex5)

names(coef(m1))

m1$assign
tINg.effects <- names(coef(m1))[m1$assign==3]

tratINgenero <- lapply(paste0("genero", levels(ex5$genero)),
                       grep, tINg.effects)

summary(m1, split=list("genero:trat"=tratINgenero))

À disposição.
Walmes.

