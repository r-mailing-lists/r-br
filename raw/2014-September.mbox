Faça através da função glht {multcomp}
dados<-structure(list(Variedade = structure(c(1L, 1L, 1L, 1L, 1L, 1L,
1L, 1L, 2L, 2L, 2L, 2L, 2L, 2L, 2L, 2L, 3L, 3L, 3L, 3L, 3L, 3L,
3L, 3L, 4L, 4L, 4L, 4L, 4L, 4L, 4L, 4L, 5L, 5L, 5L, 5L, 5L, 5L,
5L, 5L, 6L, 6L, 6L, 6L, 6L, 6L, 6L, 6L), .Label = c("RB92579 ",
"RB931003", "RB931011", "RB951541", "RB98710", "RB99395"), class = 
"factor"),
     Rep = c(1L, 2L, 3L, 4L, 1L, 2L, 3L, 4L, 1L, 2L, 3L, 4L, 1L,
     2L, 3L, 4L, 1L, 2L, 3L, 4L, 1L, 2L, 3L, 4L, 1L, 2L, 3L, 4L,
     1L, 2L, 3L, 4L, 1L, 2L, 3L, 4L, 1L, 2L, 3L, 4L, 1L, 2L, 3L,
     4L, 1L, 2L, 3L, 4L), Coleta = structure(c(1L, 1L, 1L, 1L,
     2L, 2L, 2L, 2L, 1L, 1L, 1L, 1L, 2L, 2L, 2L, 2L, 1L, 1L, 1L,
     1L, 2L, 2L, 2L, 2L, 1L, 1L, 1L, 1L, 2L, 2L, 2L, 2L, 1L, 1L,
     1L, 1L, 2L, 2L, 2L, 2L, 1L, 1L, 1L, 1L, 2L, 2L, 2L, 2L), .Label = 
c("1",
     "2"), class = "factor"), MO = c(97.25, 96.2, 95.19, 96.06,
     98.79, 98.66, 98.92, 98.85, 92.47, 96.33, 94.39, 96.55, 99.13,
     99.02, 98.93, 99.06, 95.3, 94.07, 95, 95.34, 99.18, 99.71,
     99.48, 98.63, 96.38, 97.9, 96.78, 97.46, 98.72, 99.26, 98.97,
     98.8, 95.42, 93.7, 93.38, 94.99, 98.12, 99.83, 99.03, 99.1,
     94.18, 94.89, 94.98, 94.19, 98.87, 99.59, 98.73, 98.76)), .Names = 
c("Variedade",
"Rep", "Coleta", "MO"), class = "data.frame", row.names = c(NA,
-48L))

analise<-lm(MO~Variedade,data=dados[,])
comparacaoVar<-glht(analise,linfct=mcp(Variedade="Tukey")) #onde esta 
escrito tukey você pode colocar uma matriz ou vetor de contrastes de seu 
interesse. Neste exemplo o argumento "Tukey" cria uma matriz de 
contraste de todos os níveis do fator Variedade
summary(comparacaoVar)


