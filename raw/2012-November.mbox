Use o pacote plyr e ver do for.

#  exemplo para fazer uma aov

list.dados <- lapply(data[,-c(1)], function(y){
  dm <- data[,c(1)]
  y <- y
  dfm <- cbind(dm, y)
  return(list(
    dm = dm,
    y = y,
    dfm = dfm))
})

list.av <- llply(list.dados, function(list){
  with(list, aov(y ~  trar, data=dfm))
})

list.anova <- lapply(list.av, anova)




 
