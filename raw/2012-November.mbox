Uma solução:

# Mostrando o que significa cada coisa
is.na(dados$x4)
is.na(dados$x5)
(is.na(dados$x4) | is.na(dados$x5))
!(is.na(dados$x4) | is.na(dados$x5))

# Na verdade só precisa disso aqui:
dados[!(is.na(dados$x4) | is.na(dados$x5)),]

