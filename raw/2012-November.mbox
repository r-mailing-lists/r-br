Ana vê se é isso que você esta querendo.
1ª Opção: Gráficos na vertical 
par(mfrow=c(2,1))grupoH<-subset(dados,grupo=="H")modH<-lm(grupoH$pthi~grupoH$dose)plot(grupoH$pthi,grupoH$dose)
#Para gerar alinha de tendencia você pode usar o comando abline() ou curve() coloquei os dois mas fica a seu critério.   
abline(modH)
# ou
curve(coef(modH)[1]+coef(modH)[2]*x,add=T)

grupoC<-subset(dados,grupo=="C")modC<-lm(grupoC$pthi~grupoC$dose)plot(grupoC$pthi,grupoC$dose)
#Da mesma forma para gerar alinha de tendencia você pode usar o comando abline() ou curve() coloquei os dois mas fica a seu critério.
abline(modC)
#ou 
curve(coef(modC)[1]+coef(modC)[2]*x,add=T)

2ª Opção: Gráficos na horizontal

par(mfrow=c(1,2))
grupoH<-subset(dados,grupo=="H")modH<-lm(grupoH$pthi~grupoH$dose)plot(grupoH$pthi,grupoH$dose)
