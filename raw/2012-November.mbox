> dados <- transform(download,
>                    trat = factor(trat), # transforma em fator
>                    rep = factor(rep), # idem
>                    bloco = factor(bloco)) # ...
>
> all(complete.cases(dados)) # completo
> xtabs(~rep+trat, dados)
