    u <- rCopula(n, mvdc@copula)
    x <- u
    for (i in 1:dim) {
        qdf.expr <- asCall(paste0("q", mvdc@margins[i]),
mvdc@paramMargins[[i]])
        x[, i] <- eval(qdf.expr, list(x = u[, i]))
    }
    x
}

 

 

 

