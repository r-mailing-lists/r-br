Segue solução usando o base:reshape()

DS$N <- rep(1:2, each = 6) # Cria a coluna com a variável N, identificando
os sujeitos
novoDS <- reshape(DS, timevar = 'PAISAGEM', idvar = 'N', direction =
'wide') # Transforma os dados

