> fobjetivo <- function( x = 0.1 ){
> k1 <- 0.007585776
> k2 <- 6.16595e-08
> k3 <- 2.137962e-13
> k4 <- 1e-14
> k <- k1 * k2 * k3 * k4
> # Determinar as 6 variáveis: a, b, c, d, e, f
> ###################
> # 6 Condições de contorno: ( Igualdades )
> ###################
