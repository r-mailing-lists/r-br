12   1    2005 X    

13   1    2005 Y    

11   1    2005 Y

13   1    2006 Y    

11   1    2006 Y", head=T, as.is <http://as.is> =T)

 

df$lance <- NA

df

 

for (boat in unique(df$boat)) {

     for (ano in unique(df$ano)) {

     sel <- which(df$boat==boat & df$ano==ano)

     ord <- with(df[sel,], order(dia, mes, ano))

     df[sel[ord], "lance"] <- 1:length(sel)

     }

}

 

