> k2 == a * e / d            # 2
> k3 == a * f / e            # 3
> k4 == a * b                # 4
> 4 * a == b + d + e + f     # 5
> x     == c + d + e + f     # 6
> return( c( a, b, c, d, e, f ) )
> }
