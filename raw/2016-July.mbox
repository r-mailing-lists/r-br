Uma alternativa para obter as informações do ajuste do modelo em um data
frame.

model<-nls(R~k*M^n, start=list(k=0.5,n=1), *data = df*)
stats <- tidy(model)
#  term estimate  std.error statistic      p.value
#1    k 11.53004 0.58948562  19.55949 1.808707e-10
#2    n  0.31174 0.01158954  26.89839 4.284298e-12
class(stats)
"data.frame"
stats[, 1:2]
#  term estimate
#1    k 11.53004
#2    n  0.31174


