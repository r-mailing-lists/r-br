Segue exemplos que podem ser úteis.

##-----------------------------------------------------------------------------
## CMR.

## Fatorial 4x5 em parcela subdividida.
## Calagem na parcela, adubação na subparcela.

## DIC.
da <- expand.grid(cal=gl(4,1), adub=gl(5,1), rept=gl(4,1))
da$y <- rnorm(nrow(da))
da$parc <- with(da, interaction(cal, rept))
str(da)

## Quadro de anova com 2 estratos.

m0 <- aov(y~cal*adub+Error(parc), data=da)
summary(m0)

## Retorna mensagem de aviso mas é equivalente.
m0 <- aov(y~cal*adub+Error(cal:rept), data=da)
summary(m0)

## DBC.
da <- expand.grid(cal=gl(4,1), adub=gl(5,1), bloc=gl(4,1))
da$y <- rnorm(nrow(da))
da$parc <- with(da, interaction(cal, bloc))
str(da)

## Quadro de anova com 2 estratos.

## Com bloco de efeito fixo.
m0 <- aov(y~bloc+cal*adub+Error(parc), data=da)
m0 <- aov(y~bloc+cal*adub+Error(bloc:cal), data=da)
summary(m0)

## Com bloco de efeito aleatório.
m0 <- aov(y~cal*adub+Error(bloc+parc), data=da)
m0 <- aov(y~cal*adub+Error(bloc/cal), data=da)
summary(m0)

À disposição.
Walmes.
