z

require(gregmisc)
CrossTable(z, expected = TRUE,format="SPSS")

qq=chisq.test(z);qq[]

pvalor=qq$p.value
pvalor
alfa=0.05
teste<-function(pvalor) {
if(pvalor>=alfa)      {  cat("NÃO rejeita Ho, pois pvalor =   ",pvalor, "  logo
