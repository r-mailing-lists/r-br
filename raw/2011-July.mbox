.log <- data.frame(FUN = NA, MESSAGE = NA)
fLog <- function(x, ...) {
  .log <<- rbind.data.frame(.log, c(FUN = deparse(x$call), MESSAGE = x$message))
}

tryCatch(log("1"), error = fLog)

.log

