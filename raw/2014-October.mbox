myf2 <- function(df){
    pesoFun <- with(df, approxfun(Data, Peso))
    dts <- with(df, range(Data))
    dates <- seq(dts[1], dts[2], by='days')
    pred <- data.frame(Data=dates, Animal=unique(df$Animal),
PesoPred=pesoFun(dates))
    merge(df, pred, all=TRUE)
}

library(plyr)
out <- ddply(dados2, .(Animal), myf2)


