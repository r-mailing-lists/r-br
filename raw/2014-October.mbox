Eu resolvi assim também

passeio<-function(n)
{
medias<-NULL
sd<-NULL
for (i in 1:n)
{
  medias[i]<-mean(dados2[,i])
  sd[i]<-sd(dados2[,i])
}
cbind(print(medias),print(sd))
}

passeio(10)

