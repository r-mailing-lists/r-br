*## Matriz de contrastes *
*## Antes executar a Função apc*
*apc <- function(pmc, lev=NULL){*
*  ## apc: all pairwise contrasts, pmc: popMatrix contrast*
*  nlev <- nrow(pmc)*
*  rn <- rownames(pmc)*
*  a <- attr(pmc, "grid")*
