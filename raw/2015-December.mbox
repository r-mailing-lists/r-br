##Função para conversão DN para reflectância
radconvL<-function(x, band = 2)
{
    BAND <- c("2", "3", "4", "5")
    band <- pmatch(band, BAND)
    Lmin = 0
    Qmax = 127

    if (is.na(band))
        stop("invalid band")

    if (band == 2) {
    Lmax = 120.64
    results <- x
    x <- as.vector(as.matrix(x))
    x <- Lmin + ((Lmax-Lmin)*x)/Qmax
    if (class(results) == "SpatialGridDataFrame")
        results em data[, 1] <- x
    else if (is.data.frame(x))
        results <- data.frame(matrix(x, nrow = nrow(results),
            ncol = ncol(results)))
    else results <- x
    results
    }
    else if (band == 3) {
    Lmax = 151.31
    results <- x
    x <- as.vector(as.matrix(x))
    x <- Lmin + ((Lmax-Lmin)*x)/Qmax
    if (class(results) == "SpatialGridDataFrame")
        results em data[, 1] <- x
    else if (is.data.frame(x))
        results <- data.frame(matrix(x, nrow = nrow(results),
            ncol = ncol(results)))
    else results <- x
    results
    }
    else if (band == 4) {
    Lmax = 157.57
    results <- x
    x <- as.vector(as.matrix(x))
    x <- Lmin + ((Lmax-Lmin)*x)/Qmax
    if (class(results) == "SpatialGridDataFrame")
        results em data[, 1] <- x
    else if (is.data.frame(x))
        results <- data.frame(matrix(x, nrow = nrow(results),
            ncol = ncol(results)))
    else results <- x
    results
    }
    else if(band == 5) {
    Lmax = 69.03
    results <- x
    x <- as.vector(as.matrix(x))
    x <- Lmin + ((Lmax-Lmin)*x)/Qmax
    if (class(results) == "SpatialGridDataFrame")
        results em data[, 1] <- x
    else if (is.data.frame(x))
        results <- data.frame(matrix(x, nrow = nrow(results),
            ncol = ncol(results)))
    else results <- x
    results
    }
}
