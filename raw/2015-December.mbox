Olá

segue uma sugestão:

vp = function(onda){
	
	pico = NULL
	vale = NULL
	
	for(i in 2:(length(onda)-1))
	{
		
		## seleciona valores maximos
		if(onda[i+1] < onda[i] & onda[i-1] < onda[i])
		{
			p = onda[i]
			pico = rbind(pico, p)
		}## end if pico
		
		## seleciona valores minimos
		if(onda[i+1] > onda[i] & onda[i-1] > onda[i])
		{
			v = onda[i]
			vale = rbind(vale, v)
		}## end if vale
	}##end for
	
	return(rbind(pico, vale))
}## end function

