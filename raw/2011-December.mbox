Gilbert, se vc quer mesmo usar *for* é só fazer atribuições dentro do loop
mesmo.

n<-c(87, 108, 80, 25)
nx
err.m<-matrix(NA, choose(nx,2),1)
indice <- 1
for(i in 1:nx)
  {
     for(j in 2:nx)
       {
       if(i<j){
       err.m[indice]<-sqrt((410.35/(n[i]+0.5))+(410.35/(n[j]+0.5)))
       indice <- indice + 1
              }
       }
  }

