Ho <- 12
Hvar <- 0.09061577
k <- 4.182488e-06

Lmax_fun <- function(par,Ho,Hvar,So,k){
    L <- par
    ((Ho*Hvar/((-So-(k*L^1.75))*(1-Hvar)))-L)^2
}
So <- -0.03
(Lmax <- optim(par=100,fn=Lmax_fun,Ho=Ho,Hvar=Hvar,k=k,So=So,method
="BFGS"))

abs(So)/(k*Lmax^1.75) >= 1.75+1 #Condição para valer a escolha da função

