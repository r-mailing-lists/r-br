strt<-Sys.time()
tetaM=foreach (k = 1:M,.combine=cbind) %dopar% {
y=yM[,k]
tetaM[,k]=lm(y~X-1)$coefficients
#sgn.logL(teta3,y,X)
}
print(Sys.time()-strt)

tetaM


