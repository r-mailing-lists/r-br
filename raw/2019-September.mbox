Trata-se de um experimento deduzas temperaturas e seis períodos de avaliação, em DIC. Resolvi conforme mostrado a seguir. 
Gostaria de saber se está correto. As analises ficaram boas. 




pkg= c("lattice", "latticeExtra", "doBy", "multcomp", "reshape", "plyr", "nlme") 

sapply(pkg, require, character.only=TRUE) 

source("http://dl.dropboxusercontent.com/u/48140237/bandas.R") 

sessionInfo() 

trellis.device(color=FALSE) 

ang=read.csv("ang.csv") 
str(ang) 
dh=melt(subset(ang, select=1:8), id.vars=1:2) 
d=diff(as.Date(c("2017-01-01","2017-01-16", "2017-01-31","2017-02-15", "2017-03-02","2017-03-17"))); d 
d =cumsum(c(15, d)); d 
dh$dia=d[as.integer(dh$variable)] 
levels(dh$variable) 
xyplot(value~dia|Temperatura, groups=Temperatura, data=dh, type=c("p","a"), auto.key=TRUE) 


dh1=transform(dh, D=factor(dia), parc=interaction(Rep, Temperatura), subp=interaction(Rep, Temperatura)) 
