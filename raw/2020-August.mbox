aux<-c()
result<-vector(mode="list")

for(i in 1:length(x)-1){

for(j in (i+1):length(x)){

aux[j]<-x[i]-x[j]
result[[j]]<-aux
}

}

return(abs(na.omit(unlist(result))))
}
myf(vetor)

