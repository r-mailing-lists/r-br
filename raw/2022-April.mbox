library(tidyverse); library(kableExtra);library(Taxonstand)
data("bryophytes")



bryophytes %>%
  filter(Intraspecific!="") %>%
  mutate(Scientific.name = paste(
                                  paste0("$",Genus,"$$~$"),
                                  paste0("$",Species,"$$~$"),
                                  Var,
                                  paste0("$",Intraspecific,"$$~$",".")))
%>%
  kbl(longtable = F, "html",
      escape = F) %>%
  kable_styling()

