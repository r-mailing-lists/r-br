dados <- data.frame(diag = sample(c("Fdiag","diag"),30,rep=T),valor=1:30)
###dados 2 terá apenas os que iniciam em "F"
dados2 <- dados[substr(dados$diag,1,1)=="F",]

### dados2 terá apenas os que não iniciam em "F"
dados2 <- dados[!substr(dados$diag,1,1)=="F",]


