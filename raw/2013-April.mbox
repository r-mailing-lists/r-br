juntar os 2)

data <- seq(as.Date('01/01/2013', "%d/%m/%Y"), as.Date('31/01/2013',
"%d/%m/%Y"), 1) # Cria as possíveis datas

banco <- data.frame(data=sample(data, 10), dados=rnorm(10)) # Cria um banco
de dados
todas_data <- data.frame(data=data) # Cria o data.frame com as datas
# Só precisa tomar atenção aqui que a variável que tiver a data tem que ter
o mesmo nome nos 2 bancos
(banco_final <- merge(banco, todas_data, all=TRUE)) # Junta tudo




