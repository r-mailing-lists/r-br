Boa tarde pessoal,

        Tenho dois tratamentos 1casal e 10casais mas na hora de plotar
o barplot com a função barplot2() do pacote gplots, sempre aparece
primeiro a barra 10 casais antes do 1 casal e gostaria de mudar isto, alguém teria alguma dica, sendo CRM:

#-------------------------------------------------------------------------------
#Criação das variaveis
dados <- expand.grid(trat=c("10casais","1casal"),
                   repeticao=c("I","II","III","IV","V","VI"))

dados$y <- Mod(rnorm(nrow(dados)))

# Calculando media e EP
med<-tapply(dados$y,dados$trat,mean,na.rm=TRUE)

ep<-tapply(dados$y,dados$trat,sd,na.rm=TRUE)/sqrt(tapply(dados$y,dados$trat,length))

require(gplots)
# Criando a barplot
TAB <- med
TAB2<-ep

mp <- barplot2(TAB, beside = TRUE, axisnames = FALSE, plot.ci=T, ci.u=TAB+TAB2,ci.l=TAB-TAB2, , ylab=" ", xlab=" ",legend.text=T, ylim=c(0,1),col =c("black","grey75"))
#-------------------------------------------------------------------------------
#Fim
#-------------------------------------------------------------------------------

