# order
pop <- sort(pop, T)

# Alocação
sub1 <- pop[(1:10)]
sub2 <- pop[(11:50)]

# Alocação proporcional
prop <- sub2/sum(sub2)

 set.seed(51)
sub3 <- sample(sub2, 10, replace=TRUE, prob=prop)

# Stats
  m <- c(mean(sub1),mean(sub3))
  var <- c(var(sub1),var(sub3))
 stddev <- sqrt(var)

  tab <- data.frame(m, var, stddev)
  rownames(tab) <- c("+Pop","-Pop")
  tab

