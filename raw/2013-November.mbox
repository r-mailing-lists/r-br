   alleles <- setdiff(unique.x,union("H","N"))
   y <- rep(0,length(x))
   y[which(x==alleles[1])] <- -1
   y[which(x==alleles[2])] <- 1
   y[which(x=="N")] <- NA
   return(y)
}
X <- apply(GBS[,-c(1:3)],1,parse.GBS)
dim(X)
