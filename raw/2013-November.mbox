Fátima, boa tarde!

Se você tiver a estimativa de erro armazenada em um vetor, pode utilizar
lines() para plotar o limiar.

### <BEGIN>
popfaF  <- c(37374,  54783,  86049, 126048, 287384)
obfaF   <- c(6,15,27,55,239)
txobfaF <- (obfaF*365/popfaF)*100; txobfaF
idade   <- c("1","2","3","4","5")

plot(idade, txobfaF, type="b", lty=2, ylim=c(1,40), xaxt='n',
     main="Sexo Feminino", xlab="Idade", ylab="Taxa de Mortalidade")

set.seed(457)
erro <- runif(5,1,5) ### substitua por seu cálculo do erro!
lines(idade, txobfaF+erro, lty='dashed', col=2)
lines(idade, txobfaF-erro, lty='dashed', col=2)
### <END>


