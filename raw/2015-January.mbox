#
a<-mod.2$coeff[1]###Coeficiente a
b1<-mod.2$coeff[2] ###Coeficiente b1
b2<-mod.2$coeff[3] ###Coeficiente b1
mod.2<-glm(n.insetos~temp+I(temp^2), family="poisson")
summary(mod.2)
curve(exp(a+b1*x+b2*x^2),lty=1, add=T, col="red")
#

