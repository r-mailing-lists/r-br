setwd("your working directory")

balls<-read.table("balls.txt")

f.balls<-function(b){

### test the effect of ball size on the hability to know the color or the balls

	prec<-numeric(101)

	size<-seq(0,1,by=0.01)

	p_val<-numeric(101)

	dim.uni<-numeric(101)

	rug<-b[b[,"rug"]>=1,]
	
	for (i in 1:101){ 

		prec[i]<-sum(b[,"col"]>=1 & b[,"rug"]>=1 & d[,"siz"]<=size[i])/(sum(b[,"rug"]>=1 & d[,"siz"]<=size[i]))

		prec_al<-numeric(999)

		dim.uni[i]<-(sum(b[,"rug"]>=1 & d[,"siz"]<=size[i]))		

		for (j in 1:999){

			b.al<-rug[sample(nrow(rug),size=dim.uni[i]),]

			prec.al[j]<-sum(d.al[,"col"]>=1 & d.al[,14]>=ier)/(sum(d.al[,14]>=ier))		
			
		}#eof for j
							
		p_val[i]<-(sum(prec.al>=prec[i])+1)/1000

	}#eof for i

return(list(prec=prec,p_val=p_val,dim.uni=dim.uni))

}

b.test<-f.balls(balls)

b.test$p_value

b.test$prec

b.test$dim.uni

plot(b.test$p_value)

