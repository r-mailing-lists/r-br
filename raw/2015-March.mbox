e dplyr, solução:

require(reshape2)
require(dplyr)
#Dados artificiais -----------------------------------
da <- expand.grid(trat=gl(4,1), tempo=1:10)
X <- model.matrix(~trat+tempo, da); ncol(X)
da$Esp1<-rpois(da[,1],5)
da$Esp2<-rpois(da[,1],10)
da$Esp3<-rpois(da[,1],15)
head(da)
#Empilhar
da.melt = melt(da, id = c("trat", "tempo"), 
variable.name="Esp",value.name="N")
head(da.melt)
df <- reshape2::dcast(da.melt, trat+tempo~Esp, value.var = 'N')
df <- dplyr::arrange(df, tempo)
all(df==da)
head(df)



