Pode usar a função optim:

### Gamma
G <- function(par, x)
{
   sum(dgamma(x, shape = par[1], rate = par[2], log = TRUE))
}


emv.G   <- optim(par = c(1, 10), fn = G, x = dados,
                   ,control=list("fnscale"=-1), hessian=TRUE)
emv.G$par


##### standard error
sqrt(diag(solve(-emv.G$hessian)))



