um exercicio pra matar saudade de recursao...

f <- function(n, menor, maior, x, s){
    obs <- rnorm(n, x, s)
    obs <- obs[obs > menor & obs < maior]
    nin <- length(obs)
    if (nin == n){
        return(obs)
    }else{
        return(c(obs, f(n-nin, menor, maior, x, s)))
    }
}

system.time(res <- f(10000, 2, 3, 0, 1))
##   user  system elapsed
##  0.063   0.001   0.064
length(res)
## [1] 10000
range(res)
## [1] 2.000013 2.999675


