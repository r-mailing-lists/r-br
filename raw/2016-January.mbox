c("character","character","character",
"character","numeric","character",
"numeric","numeric","numeric",
                                        "numeric","character"),
                         trim = TRUE, stringsAsFactors = FALSE
)
      x<-NULL
      results <- x
      x<-FE_tab[-(1),]
      results <- x
results<-results[!apply(results,1,function(x){any(x=="(NULL)")}),]
      results
}
