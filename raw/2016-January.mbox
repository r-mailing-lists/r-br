cat(readLines(fnames$Name[2]), sep="\n") ### informações do .hdr
(basicamente, as mesmas)

img <- readGDAL(fnames$Name[1]) ### armazena em um SGDF (pacote sp)
spplot(img)
head(coordinates(img))
head(img em data) ### dados - nesse caso temp. mínima
### </code>

