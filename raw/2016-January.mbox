var1<-rnorm(80)
tableFE<-data.frame(who, dates,var1)
head(tableFE)


MySummary<-function(x, db=tableFE){
people<-function(x){
      x<-NULL
      results <- x
      x<-unique(db[,1])
      results <- x
      results
}
TIME<-function(x){
      x<-NULL
      minT<-min(db[,2])
      maxT<-max(db[,2])
      results <- x
      x<-cbind(minT,maxT)
      colnames(x)<-c("start","end")
      results <- x
      results
}
MD<-function(x){
    MD<-mean(db[,3])
}

result<-list(people(x),TIME(x),MD(x))
return(result)
}

MySummary(db=tableFE)##

