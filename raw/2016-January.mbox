r <-raster(injuria, xmn=p0[1], xmx=p0[1]+(nCol*dCol),
                    ymn=p0[2], ymx=p0[2]+(nLin*dLin),
                    crs=CRS("+proj=utm +zone=23 +south +datum=WGS84
+units=m +no_defs"))

plot(r); points(grid, pch=21)
r
