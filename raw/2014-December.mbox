Respondendo à minha própria questão...

m <- svyglm(formula = y ~ x, design = subset(d, complete.cases(x, y)),
family = quasibinomial) sii <- svycontrast(m, quote((exp(`(Intercept)` +
x) / (exp(`(Intercept)` + x) + 1)) -
(exp(`(Intercept)`)/(exp(`(Intercept)`) + 1))))

