Veja se seria isso?

l = c(65.1537,62.0723,63.6386,63.9617,63.9687)
V = list()
s = 1
i = 2
for (n in 1:(length(l)-1)) {
  i = i + n -1
  v = 0
  for (j in 1:(length(l)-s)) {
    v = v + (l[i] - l[j])^2
    i = i+1
  }
  v = v / (2*(length(l)-n))
  i = 2
  s = s+1
  V[[paste0(n)]] <- v
}

print(unlist(V))

