Bem, você não passou CMR portanto eu não sei como anda sua programação, mas
o linear platô seria algo assim

ym <- 0.5;  # altura do platô
xm <- 6;    # ponto do cotôvelo ou troca de regime/taxa
cm <- -0.1; # taxa de decaimento
curve(ym+cm*(x-xm)^1*(x<=xm), 0, 10, main="linear platô")

x <- seq(0,10,by=0.5)
y <- ym+cm*(x-xm)^1*(x<=xm)+rnorm(x,0,0.01)
plot(y~x)

n0 <- nls(y~ym+cm*(x-xm)*(x<=xm), start=list(ym=0.5, cm=-0.1, xm=5))
summary(n0)
confint(n0)
confint.default(n0)

