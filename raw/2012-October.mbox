# Dados
  turma1=c(72,79,93,91,70,95,82,80,74,86,NA)
  turma2=c(78,66,65,84,69,73,71,75,68,90,76)
  Notas=data.frame(turma1,turma2)


# Teste da mediana
  teste.da.mediana=function(dados,alfa=0.05){
  M=median(dados,na.rm=TRUE)
  Tabela=table(dados[,1]<=M)
  for(j in 2:ncol(dados)) Tabela=rbind(Tabela,table(dados[,j]<=M))
  colnames(Tabela)=c("Acima da mediana","Abaixo da mediana")
  rownames(Tabela)=colnames(dados)
  if(length(table(Tabela<=5))==1) {Teste=chisq.test(Tabela,correct =
FALSE)} else Teste=fisher.test(Tabela)
  Conclusão=if(Teste$p.value<alfa) {"Rejeita-se a hipótese de igualdade das
medianas"} else "Não se pode rejeitar a hipótese de igualdade das medianas"
  Medianas=apply(Notas,2,median,na.rm=TRUE)
  list(Tabela=Tabela,Teste=Teste,Conclusão=Conclusão,Medianas=Medianas)
  }

  teste.da.mediana(Notas,alfa=0.05)


