Message-ID: <1349198048.84863.YahooMailNeo@web162305.mail.bf1.yahoo.com>

cor.prob <- function(X, dfr=nrow(X)-2){
  R <- cor(X,use='na.or.complete')
  above <- row(R) < col(R)
  r2 <- R[above]^2
  Fstat <- r2*dfr/(1-r2)
  R[above] <- 1-pf(Fstat, 1, dfr)
  R
}

 

