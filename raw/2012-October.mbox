CMR <- data.frame(dates = format(seq(ISOdate(2003,1,1), by='month', length=36),
                          format='%d-%m-%Y'), var=rpois(36,10))
summary(CMR)
str(CMR)
with(CMR,CMR[order(as.Date( CMR$dates,format='%d-%m-%Y'), decreasing=TRUE),])
with(CMR,CMR[order(as.Date( CMR$dates,format='%d-%m-%Y'), decreasing=FALSE),]) 


