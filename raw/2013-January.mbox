Suponha que a suma matriz com intervalos seja M
e IND o ventor de uns e zeros

IND <- (M[,1] < 2.5 & M[,2] > 2.5)
# numero de interalos que contem 2,5
sum(IND)
# proporcao
mean(IND)

o seguinte tambem dá certo:
IND <- !(M[,1] >= 2.5 ||  M[,2] <= 2.5)



