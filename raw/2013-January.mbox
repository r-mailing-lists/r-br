temp <- list()
for(i in 1:20){
    temp[[i]] <- data.frame(matrix(ncol=3,nrow=100))
    colnames(temp[[i]]) <- c('ID','Tipo','Valor')
    temp[[i]]$ID    <- paste(i,sprintf("%03d",1:100),sep='')
    temp[[i]]$Tipo  <- factor(sample(0:10,100,replace=T),levels=c(0:10))
    temp[[i]]$Valor <- rnorm(100,100,20)
