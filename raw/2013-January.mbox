Obrigado Daniel e Rodrigo, problema resolvido, segue CRM abaixo:

casal10<-c(16.03636,16.14,16.62,23.05)##Média 10 casais
sd.casal10<-(0.8402676,0.69461420,0.5656461,1.479279)#SD para 10 casais
casal1<-c(14.14000,14.21,17.37,17.26667)## Média 1casal
sd.casal1<-c(0.1166190,0.07520343,1.1059486,0.768739)#SD para 1 casal
ger<-c(3,6,9,12)## Geração
plot(ger,casal10,ylim=c(0,25),pch=16)
lines(ger,casal10)
points(ger,casal1, col='gray',pch=2)
lines(ger,casal1, col='gray')
arrows(x0=ger, x1=ger, y0=casal10+sd.casal10, y1=casal10-sd.casal10, code=3,
length=0.1, angle=90)
arrows(x0=ger, x1=ger, y0=casal1+sd.casal1, y1=casal1-sd.casal1, code=3,
length=0.1, angle=90, col='gray')
#

Alexandre


