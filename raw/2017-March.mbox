"7.txt"     "8.txt"     "9.txt"   "10.txt" "Adriele.R"



Leia_BD_i <- function(N){

  aux= c()

  for (i in 1:N){

    BD_i <- read.table("i.txt",  header = TRUE)

    media = apply(BD_i, 2, mean)

    aux = rbind(aux, media)

  }

  return(medias = aux)

}



