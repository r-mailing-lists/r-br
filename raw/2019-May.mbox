Segue um jeito de como consegui recentemente algo do gênero e tentei
reproduzir para o seu código:

require(tidyverse)
require(readODS)

banco <-
  read_ods(path = "attachment.ods") %>%
  gather %>%
  slice(13:n()) %>%
  set_names(c("Ano", "Valor")) %>%
  mutate_all(as.numeric)

banco_ts <- ts(data = banco$Valor, start = c(2000, 1), end = c(2019, 3),
frequency = 12)

banco_ts


