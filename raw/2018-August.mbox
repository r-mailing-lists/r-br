segue sugestão


SP1 = c("a","b","c","d","g","h","i")
SP2 = c("a","b","c","d","e","f","j")
SP3 = c("a","b","g","h","e","f","k")

A = setdiff(SP1, SP2)
B = setdiff(SP2, SP3)
C = setdiff(SP3, SP1)

setdiff(A, SP3)
setdiff(B, SP1)
setdiff(C, SP2)

intersect(SP1, B)
intersect(SP2, C)
intersect(SP3, A)

intersect(intersect(SP1, SP2), SP3)


