Consegui extrair os valores pra depois consultar a distribuição F.
Veja abaixo.

imp <- mice(nhanes2)
fit <- with(imp, lm(chl~age+bmi))
summary(fit)

tam1 <- length(fit)
tam2 <- length(fit[[4]])
s <- summary(fit[[tam1]][[tam2]])
p.value <- 1 - pf(q = s$fstatistic["value"], df1 = s$fstatistic["numdf"],
df2 = s$fstatistic["dendf"])
p.value


