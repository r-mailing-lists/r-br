Boa noite pessoal,

       Gostaria de saber se do ponto de vista da interpretação 
estatística do método empregado, existe diferença entre comparar 3 
tratamento hipotéticos usando:

1)
require(multcomp)
y<- c(mapply(rpois, lambda=c(5,20,5), MoreArgs=list(n=100)))##Criação da 
variável resposta
trat <- gl(3,100) ##Criação dos tratamentos
m.1 <- glm(y~trat,family="poisson")
anova.m.1 <- anova(m.1, test="Chi")
anova.m.1
summary(glht(m.1, linfct=mcp(trat="Tukey")))
#Os tratamentos 1 e 3 são semelhantes e diferentes do tratamentos 2

ou

2)
m.1 <-glm(y~trat,family="poisson")
m.0 <- glm(y~1,family="poisson")
anova(m.1,m.0,test="Chi")####Existe diferença
sort(tapply(y,trat,mean))## Ordenando as médias
levels(trat)
##Modelo T1 e T3
t1t3<-trat
levels(t1t3)
levels(t1t3)[1]<-"1+3"
levels(t1t3)[3]<-"1+3"
levels(t1t3)
m.2<- glm(y~t1t3,family="poisson")
anova(m.1,m.2,test="Chi")####Semelhantes
## Mas se faço qualquer uma das outras combinações "1+2" ou "2+3" os 
valores do teste Chi são significativos, podendo-se concluir que os 
tratamentos 1 e 3 são semelhantes e diferentes do tratamentos 2.

