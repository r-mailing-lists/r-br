*#8         p2        p3          2#o p2 que estava juntado com o p1
junta-se ao p3*
*#14        p3        p4          1**#o p3 que estava juntado com o p2
junta-se ao p4*
*#23        p5        p6          1#idem*
*#26        p6        p7          2*
*#28        p7        p8          1*

