    0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 
    0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L), F6rec = structure(c(1L, 
    2L, 1L, 5L, 4L, 5L, 5L, 5L, 2L, 5L, 1L, 4L, 5L, 5L, 2L, 2L, 2L, 
    2L, 1L, 1L, 1L, 1L, 2L, 1L, 4L, 1L, 2L, 1L, 1L, 1L, 1L, 1L, 2L, 
    1L, 1L, 2L, 4L, 2L, 2L, 2L, 3L, 2L, 3L, 2L, 2L, 5L, 1L, 1L, 2L, 
    3L, 2L, 2L, 1L, 2L, 4L, 3L, 1L, 3L, 1L, 3L, 1L, 2L, 1L, 1L, 2L, 
    2L, 3L, 1L, 5L, 1L, 4L, 2L, 1L, 2L, 2L, 1L, 2L, 4L, 2L, 1L, 3L, 
    5L, 2L, 1L, 3L, 2L, 4L, 1L, 2L, 4L, 4L, 2L, 2L, 1L, 3L, 2L, 4L, 
    2L, 2L), .Label = c("1", "2", "3", "4", "5"), class = "factor")), .Names = c("AFDIC", 
    "F6rec"), row.names = c(NA, -99L), class = "data.frame")


    # Quando ele roda o modelo o resultado do p-valor é para cada categoria da variável, porém ele gostaria também de obter o valor da variável como um todo: 


    banco$F6rec=as.factor(banco$F6rec) 

    library(epicalc)
    library(lmtest)
    library(sandwich)


    model2=glm(AFDIC~F6rec,family=poisson,data=banco)
    coeftest(model2, vcov=sandwich)


