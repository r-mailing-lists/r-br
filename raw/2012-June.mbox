Irei partir do princípios que as medidas repetidas são independentes. Se o interesse é comparar mais de duas médias podemos usar a técnica da análise de variância seguida de um teste de comparação múltipla. Segue o script.

DIA1 <- c(7.306,7.296,7.326,7.334,7.334)
DIA2 <- c(7.244,7.258,7.288,7.304,7.240)
DIA3 <- c(6.998,7.044,7.044,7.076,7.086)
DIA4 <- c(6.940,6.956,6.98,6.998,7.002)
DIA5 <- c(7.116,7.130,7.142,7.148,7.150)
pot <- c(DIA1,DIA2,DIA3,DIA4,DIA5)
dias <- rep(c('DIA1','DIA2','DIA3','DIA4','DIA5'),rep(5,5))
dad <- data.frame(dias,pot)
dad
mod <- aov(pot ~ dias,data=dad)
summary(mod)
plot(mod)#Avaliando os pressupostos.
library(agricolae)
HSD.test(mod,'dias')

(S,f,P)
Allaman

 

