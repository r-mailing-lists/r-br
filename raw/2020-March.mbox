Olá,

Segue uma sugestão:


library(tidyverse)
myfile <- read_lines("log.txt")

names_col <- c("iteration", "total_loss", "loss_error", "rate", "time", "n_images")

mydf <- myfile %>% 
  str_subset("images$") %>% 
  enframe(name = NULL) %>% 
  separate(col = value, into = names_col, sep = "[:,]") %>% 
  mutate_all(parse_number)

mydf


Atenciosamente,
Max Richard Verginio

