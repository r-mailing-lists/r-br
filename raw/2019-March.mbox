controle=lmeControl(maxIter=200,msMaxIter=200,opt="optim")
modeloCT_F<- lme(CT~GS+Tratamento*Semana+Pbserica+Pnasc,random=~1|Animal,data=subset(BiometriaAleit,Sexo=="Femea"))
