Eu tenho esse script, não sei se resolve

repetição<-2000

aasteste11<-matrix(nrow=repeticao,ncol=6) #ncol=número de parêmtros a serem
guardados

for (i in 1:repeticao)
{
indice1 <- sample(dim(dados1)[1], 2000, replace=T)
amostra1 <- dados1[indice1,]
#guardando a amostra
nome<-paste("AAS",i,cenario,".txt",sep="")
write.table(amostra1,nome,quote=F,row.names=F)
amostra1.mod <- glm(obt~part*servidor + servidor +
part,family=binomial(link="logit"), data=amostra1)
aasteste11[i,]<-amostra1.mod$coefficient
}
#salvando os coeficientes
nome <- paste("coefAAS",cenario, ".txt", sep="")
write.table(aasteste11,nome,col.names=c("parametro1","parametro2","parametro3","parametro4","parametro5),quote=F,row.names=F)

