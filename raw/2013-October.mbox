Oi Eric, veja no anexo que estou lhe enviando. É isso aí que você quer?
segue o código utilizado:

library(sfsmisc)

par(mar=c(3,4,2,2))

areadrenagem<-c(1.02038%*%10^12,1.19895%*%10^11,1.1403%*%10^12,1.14758%*%10^12,7.78202%*%10^10,1.22573%*%10^12,1.80369%*%10^11,2.61352%*%10^11,1.72428%*%10^12,1.77253%*%10^12,1.80291%*%10^12,3.7624%*%10^11,2.20128%*%10^12,7.18029%*%10^11,2.92493%*%10^12,1.32153%*%10^12,4.37759%*%10^12,4.67111%*%10^12)

vazao<-c(35680,5875,53422.22222,53597.5,2966.25,55796.5,3189.833333,16786.91667,75085.4,83921.41667,86233.33333,11849.41667,94891.75,32970.90909,122827.2222,22297.36364,146948.5556,156321.9)

plot(vazao~areadrenagem,axes=FALSE,frame=TRUE)
aX <- axTicks(1) # do pacote sfmisc
aY<-axTicks(2,usr=vazao) #pacote sfmisc
axis(1, at=aX, label=axTexpr(1, aX))
axis(2, at=aY, label=axTexpr(2, aY))

