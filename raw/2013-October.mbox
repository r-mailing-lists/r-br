plot(vazao~areadrenagem,axes=FALSE,frame=TRUE)

aX <- axTicks(1)
*aY<-axTicks(2,usr=vazao)* # substitua esta expressao pelo comando 
abaixo "teste"
teste<-expression(0,0.5%*%10^5,1 %*% 10^5, 1.5 %*% 10^5)
axis(1, at=aX, label=axTexpr(1, aX))
