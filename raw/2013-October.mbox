ggplot(seguro, aes(Ano, V2, fill=Ano))+geom_bar(width=0.3,stat="identity",
position="identity", aes(fill=Ano)) +
scale_y_continuous(labels=percent) +
geom_text(data=seguro,aes(x=Ano,label=V3),vjust=0)

