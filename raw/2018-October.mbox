Uma ideia:

library(tidyverse)

seus_dados <- tibble(nome = c("Nome A", "Nome A", "Nome B", "Nome C", "Nome B", "Nome C"))

ids <- seus_dados %>%
  distinct(nome) %>%
  mutate(id = row_number())

seus_dados_com_id <- left_join(x = seus_dados,
                               y = ids,
                               by = "nome")

