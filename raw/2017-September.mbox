modelo.nlme.0<-nlme(modelo1.list)
controle<-nlmeControl(maxIter=300,msMaxIter = 300,niterEM= 100)

modelo.nlme.1.bc<-update(modelo.nlme.0,fixed=list(a~TRAT,b+c~1),
correlation=corSymm(), weights=varIdent(form=~1|SEMANA),
start=c(4.70,0,0,4.6,0.34), control=controle)

#-----------------------------------------------------------------------------------
panel.function <- function(x,y,subscript,...){
    panel.xyplot(x,y,...)

panel.lines(GALINHA$SEMANA[subscript],predict(modelo.gompertz.1.SYMM.IDENT,newdata
= GALINHA[subscript,]),lwd = 4,col = "black")
}

xyplot(PESO~SEMANA |TRAT,groups = ID,type = "l",
       panel =panel.function,data = DADOS)


