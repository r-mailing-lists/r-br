modelo1.list <- nlsList(PESO ~ a * exp(-b * exp( -c * SEMANA)),start = c(a
= 4.10,b = 4.53,c = 0.37 ),na.action=na.omit,data =GALINHA)
modelo.nlme.0<-nlme(modelo1.list)
controle<-nlmeControl(maxIter=300,msMaxIter = 300,niterEM= 100)
modelo.nlme.1<-update(modelo.nlme.0,fixed=list(a+b+c~TRAT),start=c(4.10,0,0,4.77,0,0,0.34,0,0),control=controle)
