Bom dia,

Um exemplo que pode lhe ser útil:

### <code r>
mtcars
x <- with(mtcars, ftable(cyl~vs+gear)); x
# cyl  4  6  8
# vs gear
# 0  3      0  0 12
# 4         0  2  0
# 5         1  1  2
# 1  3      1  2  0
# 4         8  2  0
# 5         1  0  0

df <- as.data.frame(x); head(df, 3)
# vs gear cyl Freq
# 1  0    3   4    0
# 2  1    3   4    1
# 3  0    4   4    0

require(reshape2)
y <- dcast(df, vs+gear~cyl, value.var="Freq")
y
# vs gear 4 6  8
# 1  0    3 0 0 12
# 2  0    4 0 2  0
# 3  0    5 1 1  2
# 4  1    3 1 2  0
# 5  1    4 8 2  0
# 6  1    5 1 0  0

class(y)
# [1] "data.frame"

### </code>



