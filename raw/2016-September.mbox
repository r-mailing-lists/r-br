207L, 0L, 207L, 1L, 206L, 5L, 201L, 1L, 200L), .Names = c("Total",
"Didn't consent", NA, "Age < 18", NA, "HIV negative", NA, "No cough and
normal X-ray",
NA, "CD4+ > 200", NA, "Pregnancy", NA, "No urine available",
