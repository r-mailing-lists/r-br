family=poisson)

#Criando modelo nulo para teste
m.null<-glmer(abundancia~1+(1|distancia)+(1|replica), family=poisson)

#Teste contra modelo nulo
anova (m1, m.null, test="Chisq")
#Ok, diferente do modeulo nulo.

