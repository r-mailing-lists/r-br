Uma forma de fazer:

### <code r>
require(geoR); require(rgdal); require(raster)

# Predição por krigagem ordinária
kloci   <- expand.grid(seq(0,1,l=21), seq(0,1,l=21))
kcontr <- krige.control(cov.pars=c(1, .25))
kc <- krige.conv(s100, loc=kloci, krige=kcontr)
image(kc, asp=1)

pred <- cbind(kloci,kc$pred)     ### data.frame com dados da predição
coordinates(pred) <- ~Var1+Var2  ### transforma em SPointsDF
gridded(pred) = TRUE             ### transforma em SPixelsDF
spplot(pred)

writeGDAL(pred, 'teste.tif', drivername = 'GTiff')
### </code>

