## criando o fator parcela fora da aov
ps$parcela <- with(ps, interaction(BL, AD))

## mesmo modelo
m1 <- aov(alt~BL+AD*ES+Error(parcela), data=ps)

## a mesma anova
summary(m0)
summary(m1)

a <- model.matrix(~BL:AD, ps)
dim(a)
b <- model.matrix(~parcela, ps)
dim(b)

