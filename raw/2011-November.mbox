meu código é o seguinte:

cenarios <- c(1:7)
con <- 1
for (i in cenarios){
 setwd(paste('C:\\Users\\l01199\\Desktop\\Modelo\\Resultados\\Modelo_Cenario',i,'_Q1300',sep=''))
 files  <- sort(list.files(pattern = "m000.TXT"))[1:50]
