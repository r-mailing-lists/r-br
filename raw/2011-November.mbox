#instalando pacote
install.packages(beeswarm)
library(beeswarm)

#dados
Densidade<-round(c(rnorm(30,2),rnorm(30,5)))
Local<-rep(c("A","B"),each=30)

#grafico
beeswarm(Densidade~Local,method="center",cex=1.4,pch=16,do.plot=F)
abline(v=c(1,2))



