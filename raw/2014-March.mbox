Em Sábado, 15 de Março de 2014 13:47, Robert Iquiapaza <rbali em ufmg.br> escreveu:
 
#http://pages.stat.wisc.edu/~yandell/st571/R/append7.pdf
var.interval = function(data, conf.level = 0.95) {
df = length(data) - 1
chilower = qchisq((1 - conf.level)/2, df)
chiupper = qchisq((1 - conf.level)/2, df, lower.tail = FALSE)
v = var(data)
c(l.inf=df * v/chiupper, l.sup=df * v/chilower)
}

plot(x=rnorm(48,34,7))
hist(x)
var(x)
var.interval(x)



