range(x)
table(x)
seq(41,60,6) ### ficam valores fora do intervalo (60)
seq(41,66,6) ### inclui todos intervalos com valores
seq(35,71,6) ### irá adicionar intervalos vazios nos extremos

tab=fdt(x,start=35,h=6,end=71)
tab
plot(tab, type= "fp")
