Senhores, boa tarde!

Tenho um código básico que pode ser desenvolvido...

### <code r>
require(MASS)
topo
gd <- as.geodata(topo); names(gd)

plot.geodata(gd)
attach(gd)

### 1
plot(coords, xlab = "X Coord", ylab = "Y Coord ", type = "n")
#polygon(borders)
dCut <- cut(data, breaks = unique(quantile(data)), include.l=T, labels=F)
points(coords, pch = (1:4)[dCut], col=2:7)

### 2
plot(data, coords[, 2], ylab = "Y Coord", xlab = "data", cex = 1)
lowY <- lowess(data ~ coords[,2])
lines(lowY[[2]],lowY[[1]], col=2)

### 3
plot(coords[, 1], data, xlab = "X Coord", ylab = "data", cex = 1)
lowX <- lowess(data ~ coords[,1])
lines(lowX, col=2)

### 4
hist(data, main='', xlab = 'data', prob = T)
lines(density(data), col=2)
### </code>


