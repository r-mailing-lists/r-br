Assunto: Re: Res: Res: [R_STAT] gráfico da função de verossimilhança no R


aqui vai um exemplinho especifico da normal considerando a verossimilhanca
para ambos parametros:

dados <- rnorm(50)
mu.vals <- seq(-3,3, len=100)
sigma.vals <- seq(0.5, 5, l=100)

logV <- function(pars, y)
sum(dnorm(y, mean=pars[1] , sd=pars[2], log=TRUE))
ll <- apply(expand. grid(mu.vals, sigma.vals), 1, logV, y=dados)
range(ll)

contour(mu.vals, sigma.vals, matrix(ll, nc=length(sigma. vals)),
levels=seq(- 200, -70, by=10))

