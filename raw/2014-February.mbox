#Código
resp=scan(nmax=8)
82.8
55.1
74.3
72.2
64.7
51.3
69.9
53.3

#replicated
rad=rep(c(+1,-1),time=4,each=1)
rad
pH=rep(c(+1,-1),time=2,each=2)
pH
area=rep(c(+1,-1),each=4)
area

order=(1:8)
order


fat=data.frame(rad,pH,area,resp,order)
fat
aov.2=aov(resp~rad+pH+area, data=fat)
summary(aov.2)

#Gráfico de pareto

MSE=41.7 #Obtido a partir de 
coef1=c(aov.2$coef[2:4])
coef1
n=8
f1=t(abs(coef1))/(sqrt(MSE/n));f1
z=data.frame(f1)
names(z)
v1=qt(0.975,8)
coef3=sort(abs(coef1))
coef3
g=barplot(sort(f1),horiz=TRUE,names.arg=c( names(coef3)),col=ifelse(sort(f1)>v1,"blue","gray"))##xlim, ylim
box("plot", col="blue")  

abline(v=qt(0.975,8),col="red",lty=2)
s=format(qt(0.975,8),digits=2)
text(2.5,1,label=s,cex=1)
mtext("Efeito padronizado", side=3, line=2, cex=1.0, col="blue", outer=FALSE)
p=format(f1,scientific = TRUE)
legend(x=6,y=4,cex=0.6,bg="yellow",box.col="blue", legend=c( "Rad=7.475","area=5.650","pH=-1.975" ), col="blue", lwd=1:2, lty=c(NA,NA,NA))
