tmp <- table(s2$Unique_Identifier,s2$AdmissionMainDiagnosisName_sec)
tmp <- as.data.frame(cbind(Unique_Identifier=rownames(tmp),tmp))
rownames(tmp) <- seq_along(rownames(tmp))
colnames(tmp)[2:ncol(tmp)] <- paste0("AMDN_sec_",colnames(tmp)[2:ncol(tmp)])
# View(tmp)
# lapply(tmp,table)
tmp2 <- table(s2$Unique_Identifier,s2$AdmissionReasonName_sec)
tmp2 <- as.data.frame(cbind(Unique_Identifier=rownames(tmp2),tmp2))
rownames(tmp2) <- seq_along(rownames(tmp2))
rownames(tmp2) <- seq_along(rownames(tmp2))
colnames(tmp2)[2:ncol(tmp2)] <-
paste0("ARN_sec_",colnames(tmp2)[2:ncol(tmp2)])
# View(tmp2)
# lapply(tmp2,table)
s3 <- merge(tmp2,tmp,all=T,sort=F)
# View(s3)
# dim(s3)
s3[,2:ncol(s3)] <-
sapply(2:ncol(s3),function(i)ifelse(s3[,i]==1,"True","False"))

Obrigado,

Pedro Brasil

