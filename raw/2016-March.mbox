0.25),
             c(rnorm(10, 12, 0.25), rnorm(50, 2.5, 0.25)), rnorm(60, 2.5,
0.25))
colnames(sp) <- c("sp1", "sp2", "sp3", "sp4")
head(sp)

#Criação da matriz de contrastes
TI    <- model.matrix(~ treat-1)
head(TI)

f    <- length(levels(treat))
comb <- t(combn(1:f, 2))
n    <- nrow(comb)

contr2 <- NULL
for (x in 1:n) {
     i <- comb[x, 1]
     j <- comb[x, 2]
     tmp <- list(TI[,i] - TI[,j]); names(tmp) <- paste0("TI",i, "_", j)
     contr2 <- c(contr2, tmp)
}
contr2

