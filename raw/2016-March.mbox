#Função by Walmes
pn <- function(X){crossprod(!is.na(X))}

cor.prob <- function(X){
      pair.SampSize <- pn(X)
      above1 <- row(pair.SampSize) < col(pair.SampSize)
      pair.df <- pair.SampSize[above1] - 2

      R <- cor(X, use="pair")
      above2 <- row(R) < col(R)
      r2 <- R[above2]^2
      Fstat <- (r2 * pair.df)/(1 - r2)
      R[above2] <- 1 - pf(Fstat, 1, pair.df)
      R
      }


correla <- round(cor.prob(var1,var2,var3,var4),4)

