Bom dia como posso aumentar a fonte dos números do correlograma? Usando a função:

library(corrplot)
library(Boruta)
library(car)
library(PerformanceAnalytics)
library(caret)
library(Rcmdr)
library(corrgram)


#Definindo os genótipos como nome dos casos:
row.names(dados) <- as.character(dados$genotipos)
dados$genotipos <- NULL

#Gerando o correlograma
dados<-as.matrix(dados)
chart.Correlation(dados, histogram=TRUE, pch=19, main= "Moderately Resistante")  # plot correlogram (com histograma)
chart.Correlation(dados, histogram=FALSE, pch=19)  # plot correlogram (sem histograma)

