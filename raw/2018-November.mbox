Certamente há uma maneira mais elegante de fazer isso, mas talvez esse
código te dê alguma pista:

df %>%
  spread(CAUSA, CAUSA) %>%
  unite(CAUSAS, A, B, C, D, E, F, G, H, I, sep = ",", remove = T) %>%
  mutate(CAUSAS = str_remove_all(CAUSAS, ",NA")) %>%
  mutate(CAUSAS = str_remove_all(CAUSAS, "NA,"))

