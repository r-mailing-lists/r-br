library(plyr)

arranjo<-function(x){
valido <- c()
for(i in 1:nrow(x)){
if(x[i,2]==max(x[,2])){
valido[i]<-1
if( x[i,3]>= max(x[,3]) & x[i,2]==max(x[,2])){

valido[i] <-1
}else{

valido[i] <- 0
}
if(x[i,4]>= max(x[,4])){
valido[i] <- 1
}else{

valido[i] <- 0
}
}else{
valido[i]=0
}
}
return(mutate(x,valido=valido))
}

ddply(dados,.(Local, Data),arranjo)

