Pessoal,

gostaria de sugestões de soluções simples para análise do experimento a 
seguir.

#------------------------------------------------------------------
#Experimento fatorial com dois fatores em DIC
#Fator 1: Solo (4 tipos de solo)
#Fator 2: Profundidade (3 profundidades)
#Variável resposta: Teor de cromo
#Desbalanceado: não foi possível detectar a variável resposta
#para alguns solos em alguma profundidade.
#------------------------------------------------------------------
rm(list = ls())
solo <- rep(c("S1","S2","S3","S4"), each=15) #solos
prof <- rep(rep(c("P1","P2","P3"), each=5),4) #profundidades
rep <- rep(1:5, 12) #repetição
cromo <- c(30.40,   4.28,   9.27,  14.46,  10.54,  34.52, 6.36,
            16.89,  18.92,  12.92, 44.63,  18.53,  23.42,  23.37,
            18.43,  57.54, 132.40, 129.17, 135.37, 157.58, 67.89,
            154.09, 162.63, 155.19, 171.08,  70.82, 122.19, 164.69,
            179.06, 160.65, 121.25,  37.54,  30.26,  46.60,   NA,
            81.91,  26.35,  34.91,  46.03,  13.42, NA, NA,   NA,
            NA,     NA,   1.80,   4.33,   8.57,   3.75,   2.31,
            4.12,  10.72,  24.70,   6.50,   3.55,  57.91,   1.58,
            NA,  97.41,  56.73)

dados <- data.frame(solo, prof, rep, cromo)
str(dados)
#dados<-na.omit(dados)
#str(dados)
require(lattice)
xyplot(cromo~prof|solo, data = dados)
xyplot(cromo~solo|prof, data = dados)
library(car)
#Type III SS ANOVA
names(dados)
m1 <- Anova(lm(cromo ~ solo * prof, dados),
             type = "3")
m1
require(easyanova)
dado <- dados[,c(1:2,4)]
m2 <- ea2(data=dado, design = 1, alpha = 0.05,
           list = FALSE, p.adjust=1, plot=2)
m2
#---------------------------------------------------------------------

