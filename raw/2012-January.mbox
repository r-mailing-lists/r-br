Flávia,
trat <- gl(5,10)
resp <- rnorm(trat)

m.aov <- aov(resp~trat)
summary(m.aov)

### Conforme sugerido pelo Andre,
require(lawstat)
?levene.test
levene.test(m.aov$residuals,trat)
### Normalmente, pessoalmente uso bartlett
bartlett.test(m.aov$residuals~trat)
### Para normalidade, Shapiro
shapiro.test(m.aov$residuals)
Att
Éder

