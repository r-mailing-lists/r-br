for (i in k+1:length(x)){

m <- a[i,k]/a[k,k]

a[i,k] <- 0
for(j in k+1:length(x)){

a[i,j] <- a[i,j]-m*a[k,j]

b[i] <- b[i]-m*b[k]
}
}
}

x[length(x)] <- b[length(x)]/a[length(x),length(x)]

for (k in length(x)-1:1){

s <- 0
for (j in k+1:length(x)){

s <- s+a[k,j]*x[j]
}

x[k] <- (b[k]-s)/a[k,k]
}


--
