set.seed(1234)

x <- rnorm(100)
y <- x + rnorm(100)

par(mfrow=c(1, 3), cex=1.2)

par(family="sans") # fonte sem serifa
plot(y ~ x, xlab=expression(paste("Média (",mu,"cm)")),
ylab=expression(paste("Média (",chi,"kg)")), main="Teste de Fonte")

par(family="serif") # fonte com serifa
plot(y ~ x, xlab=expression(paste("Média (",mu,"cm)")),
ylab=expression(paste("Média (",chi,"kg)")), main="Teste de Fonte")

par(family="mono") # fonte monoespaçada
plot(y ~ x, xlab=expression(paste("Média (",mu,"cm)")),
ylab=expression(paste("Média (",chi,"kg)")), main="Teste de Fonte")

