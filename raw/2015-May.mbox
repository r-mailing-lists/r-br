Pedro,

Use o script.

library(ggplot2)
library(grid)
library(gridExtra)

graphic1 <- ggplot(......)
graphic2 <- ggplot(......)

tmp <- ggplot_gtable(ggplot_build(graphic1 ))
leg <- which(sapply(tmp$grobs, function(x) x$name) == "guide-box")
legend <- tmp$grobs[[leg]]

grid.arrange(arrangeGrob(graphic1 + opts(legend.position="none"),
                         graphic2 + opts(legend.position="none")),
             legend, widths=c(9, 0.8), nrow=1)


