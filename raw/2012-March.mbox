Victor,

Você pode fazer assim:

# assumindo que x seja seu objeto com 30 colunas
x <- as.data.frame(matrix(rnorm(30*2*10), ncol = 30))
do.call(cbind, lapply(split(names(x), rep(1:15, each = 2)),
function(.x)t(apply(x[.x], 1, sort))))

