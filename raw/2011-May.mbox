\affil[3]{Afiliacao 3}

\date{}

\begin{document}
\maketitle

afdkjfdalk fda.
\end{document}
%% fim

\footnote usa, por padrao, arabicos sim... mas e' necessario que a
chamada seja dentro do corpo do texto.

