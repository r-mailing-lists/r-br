#pvalor=ks.test(x, pexp, rate=5)$p.value

#EXEMPLO DE DIST. EXP
x <- rexp(30, rate=5)
ks.test(x, pexp, rate=5)
pvalor=ks.test(x, pexp, rate=5)$p.value

pvalor
alfa=0.05
teste<-function(pvalor) {
if(pvalor<alfa)      {  cat("rejeita Ho  >>> pvalor é ",pvalor, "    NÃO TEM DIST. EXP  ","\n")    }
else if(pvalor>=alfa)    {  cat("NÃO rejeita Ho >>> pvalor é   ",pvalor, "  TEM DIST. EXP.  ","\n")    } 
}
teste(pvalor)



