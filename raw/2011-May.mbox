uma extensao, baseada no codigo inicial do victor, que tambem funciona
para variacia desconhecida...

ic.media <- function(x, sigma2, conf.level=0.95){
    n <- length(x)
    xbarra <- mean(x)
    if (!missing(sigma2)){
        z <- qnorm((1+conf.level)/2)
    }else{
        sigma2 <- var(x)
        z <- qt((1+conf.level)/2, n-1)
    }
    return(mean(x)+c(-1, 1)*z*sqrt(sigma2)/sqrt(n))
}

ex <- rnorm(100)
ic.media(ex)
ic.media(ex, 1)

b

