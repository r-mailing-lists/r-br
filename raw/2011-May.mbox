## Experimento pH vs tempo

dados <- read.table("dosagem.txt", h=T)
names(dados)
attach(dados)

B <- factor(Rep)
D <- factor(Dose)
T <- factor(Tempo)


modelo <- lm(Leitura ~ D*T+B:D)
anova(modelo)

