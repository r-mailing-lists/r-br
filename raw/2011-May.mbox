Oi Victor,

Pode usar se inspirar no exemplo abaixo:

library(TeachingDemos)
x=c(62,58,61,60,51,61, 66, 63, 71, 59, 68, 50, 62, 62, 58, 54, 56, 58, 49,
65)
p <- 0.95
s2=var(x)
gl=length(x)-1

pinvchisq <- function(x, df=gl, scale=s2) {
    prob <- pchisq(scale/x, df)
    return(1-prob)
}


qinvchisq <- function(p, df=gl, scale) {
    qprob <- qchisq(1-p, df)
    return(scale/qprob)
}

hpd(qinvchisq,df=gl,scale=s2,conf=.95)

Att,
Greice.

