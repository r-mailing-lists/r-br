Acredito que sua solução é essa.
data <- replicate(5, rnorm(10))
colnames(data) <- paste("Sample", c(1:ncol(data)))
rownames(data) <- paste("Gene", c(1:nrow(data)))
data

dados2<-subset(data,abs(data[,4])>1.3)
dados2

