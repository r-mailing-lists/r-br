Boa tarde Flávio,

Fiz um teste acrescentando o nome do país e separando por vírgula. O que ajuda a busca a entender que se trata de um município.


library(RgoogleMaps)

# Município, Estado, País
aux_city <- c(
  "Vitória, ES, BR",
  "Serra, ES, BR",
  "Vila Velha, ES, BR",
  "Cariacica, ES, BR",
  "Colatina, ES, BR"
)

aux_city_coord <- data.frame(Municípios = aux_city,
                             lat = NA,
                             long = NA)
aux_city_coord <-
  with(aux_city_coord,
       data.frame(Municípios = aux_city_coord$Municípios,
                  t(
                    sapply(aux_city_coord$Municípios, getGeoCode)
                  )))
aux_city_coord


