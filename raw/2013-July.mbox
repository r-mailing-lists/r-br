Library(nlme)


expo.der <- deriv3(~a*exp(c*Gest), c("a", "c"),function(Gest, a,c) NULL)
str(expo.der)

n0 <-gnls(NaGLAMA~expo.der(Gest,a,c),weight=varIdent(form=~1|Gest),na.action=na.omit,
data=GM[-c(59,57,61),],subset=c(Fetos==1),start=start)

pred <- data.frame(Gest=seq(90,150,20))
der <- do.call(expo.der, args=c(list(Gest=pred$Gest), as.list(coef(n0))))
F <- attr(der, "gradient") # gradiente avaliado no novo t
U <- chol(vcov(n0))
se <- sqrt(apply(F%*%t(U), 1, function(x) sum(x^2))) # erro padrão

