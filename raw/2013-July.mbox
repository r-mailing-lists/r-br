Gestacional(dias)",
     ylab="Conteúdo de Sódio (g)",xlim=c(90,150))
matlines(pred$Gest,c(der)+
           outer(se, qt(c(.5,.025,.975),
df=summary(n0)$dim$N-summary(n0)$dim$p)),
