                {

                                for(j in 1:ncol(matrizDensidade))

                                {

 
somaLogLik=somaLogLik+matrizEsperancas[i,j]*matrizDensidade[i,j]

                                }

                }

 

return(somaLogLik)

 

}

 

 

 

