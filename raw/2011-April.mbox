cust <- function(x,fun) {

  nomes <- names(vec)
  lista <- list()
  lista[[1]] <- NULL
  TAM <- length(x)

  for (i in 1:TAM+1) lista[[i]] <- as.numeric(x[i-1])

  lista[[TAM+2]]   <- fun
  names(lista) <- c("x",names(vec),"fun")
  lista
