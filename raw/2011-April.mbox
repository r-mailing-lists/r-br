logLikelihood=function(parametrosLike)

{

                matrizDensidade=matrix(0,length(vetor),2)

      sigma21=rep(1,length(serie))

      sigma22=rep(1,length(serie))

                nu1=parametrosLike[7]

                nu2=parametrosLike[8]

                mu1=parametrosLike[9]

                for(i in 2:length(vetor))

                {

                erro2=serie[i-1]^2

 
sigma21[i]=parametrosLike[1]+parametrosLike[2]*erro2+parametrosLike[3]*sigma
21[i-1]

 
sigma22[i]=parametrosLike[4]+parametrosLike[5]*erro2+parametrosLike[6]*sigma
22[i-1]

 

 
matrizDensidade[i,1]=log(dged(vetor[i],mu1,sqrt(sigma21[i]),nu1))

 
