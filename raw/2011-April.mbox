Se deseja avaliar uma string, pode usar o parse combinado com o eval:

mF <- function(x=seq(1, 5, by=1),
              y=seq(0, 10, by=5),
              z='2 - 0.4*y - 0.5*x + 0.8*sqrt(x)')
{
 z <- outer(x, y, function(x, y) eval(parse(text = z)))
 z
}

