require('systemfit')
data("Kmenta")
attach(Kmenta)
eqDemand <- consump ~ price + income
eqSupply <- consump ~ price + farmPrice + trend
eqSystem <- list(demand = eqDemand, supply = eqSupply)
fitols <- systemfit(eqSystem)
summary(fitols)

