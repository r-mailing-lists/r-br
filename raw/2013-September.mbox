  #  14.25   31.95   50.02   46.21   57.73   89.87 
  #diferenças
  d<-diff(vetor, lag=1)


  k<-140
  pctMaiorDepois<-NA
  marcacoes<-NA
  progress<-seq(2,(length(vetor)-k), by=10000)
