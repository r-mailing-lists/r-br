Para não ter que mudar o formato da data no arquivo original, o melhor é
declarar ela como data (através do as.Date()):

datas <- c("10/11/2011", "17/03/2010", "15/05/2011")
valor <- c(34, 27, 54)
df <- data.frame(data = as.Date(datas, '%d/%m/%Y'), valor)

df[order(df$data), ]

