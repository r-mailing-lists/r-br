set.seed(1)
n <- 500x <- floor(runif(n, 18, 80))y <- 5*x - 0.05*x^2  + rnorm(n, mean=0, sd=10*sqrt(x))plot(x, y)taus <- 1:9/10
library(quantreg)modelo <- rq(y ~ x , tau=taus)
valoresPreditos <- predict(modelo)
dadosGraficos <- data.frame(valoresPre = as.numeric(valoresPreditos),                             tau = as.factor(rep(taus, each=n)),                            x = rep(x, times=length(taus)))
library(ggplot2)g <- ggplot(unique(dadosGraficos), aes(x=x, y=valoresPre, group=tau)) + theme_bw()g + geom_line(aes(linetype=tau))


