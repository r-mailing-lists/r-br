Mais uma correção e simplificando:

conv3 <- function(n, m=0.1, dp=sqrt(0.05)) {
  u <- numeric(n+1)
  f <- function(x) {pnorm(x,m,dp)}
  p <- function(x) {f(x)}
  I <-  function (x) {-p(x)*log2(p(x)) }
  u[1]<- I(0)
  for (i in 2:(n+1)) {
    f  <-  function(i) {pnorm(i*1/n,m,dp)}
    p <-  function(i) {f(i)-f(i-1)}
    u[i]<- I(i)
  }
 return(u)
}

