>> {
>>   r<-ve-vr
>>   r2<-r^2
>>   soma<-sum(r2)
>>   n<-length(r2)
>>   remq<-sqrt((1/(n-1))*soma)
>>   result<-c("Raiz do Erro Médio Quadrático"=remq)
>>   return(result)
>> }
>>
>> # Calculando o REMQ
