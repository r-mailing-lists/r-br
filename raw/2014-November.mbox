conv<- function(n) {
                   u <- matrix(nrow=n+1,ncol=1)
                        for (i in 0:n) {
                                if (i==0) {
                                      f <- function(i) {pnorm(i,m,dp)}
                                      p<- function(i) {f(i)}
                                } else  {
                                      f  <-  function(i) {pnorm(i*1/n,m,dp)}
                                      p <-  function(i) {f(i)-f(i-1)}
                               }
                     I <-  function (i) {-p(i)*log2(p(i))}
                     u[i,]<- I(i)}
                   y <-u[0:n,]
                   y }


