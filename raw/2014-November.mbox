From edsonlontra em yahoo.com.br  Sat Nov 22 19:07:04 2014
From: edsonlontra em yahoo.com.br (Edson Ferreira)
Date: Sat, 22 Nov 2014 21:07:04 +0000 (UTC)
Subject: [R-br] grafico de efeitos espaciais - est. espacial
Message-ID: <1409184462.2582785.1416690424750.JavaMail.yahoo@jws10065.mail.ne1.yahoo.com>

 Paz     e  Bem !! 
estou com o seguinte codigo, para modelos CAR com dados de contagem (Poisson)
e gostaria de plotar no grid criado  um grafico em tom de cinzacom os efeitos espaciais e um outro com a média de cada regiãonão estou conseguindo.neste modelo qual a saída q mostra o valor estimado pro rho.?desde ja obrigado


############################  CARBayes   Leroux vs  CAR   #######################################
#####################################################################
rm(list=ls())
require(spatstat)
require(lattice)
require(MASS)
require(coda)
require (MCMCpack)
require(plotrix) 
require(CARBayes)

##########  simulação


x.easting= 1:10
x.northing <- 1:10
Grid <- expand.grid(x.easting, x.northing)
n <- nrow(Grid)


distance <-array(0, c(n,n))
W <-array(0, c(n,n))
    for(i in 1:n)
    {
        for(j in 1:n)
        {
        temp <- (Grid[i,1] - Grid[j,1])^2 + (Grid[i,2] - Grid[j,2])^2
        distance[i,j] <- sqrt(temp)
            if(temp==1)  W[i,j] <- 1 
        }    
    }
    

x1= rnorm(n)  # variavel 1
x2= rnorm(n)  # variavel 2
E= rep(50,n)  # valor esperado para cada regiao 
theta= rnorm(n, sd=0.05)   #
phi <- mvrnorm(n=1, mu=rep(0,n), Sigma=0.4 * exp(-0.1 * distance))
risk <- exp(-0.2 +  0.1 * x1 + 0.1*x2 + theta + phi)
fitted <- E * risk
Y <- rpois(n=n, lambda=fitted)

formula <- Y ~ x1 + x2 + offset(log(E))

model <- poisson.lerouxCAR(formula=formula, W=W, burnin=50, n.sample=1000)



model$formula
model$samples
model$fitted.values
model$random.effects
model$residuals
model$W.summary
model$DIC
model$p.d
model$summary.results
model$model
model$accept






    AttEdson
 
